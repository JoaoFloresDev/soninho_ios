    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise Alarm uses motion sensors to detect your sleep phases and wake you at the optimal moment during light sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise Alarm usa los sensores de movimiento para detectar tus fases de sueño y despertarte en el momento óptimo durante el sueño ligero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise Alarm usa os sensores de movimento para detectar suas fases de sono e acordá-lo no momento ideal durante o sono leve."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise Alarm uses the microphone to measure ambient sound levels during sleep to improve sleep phase detection accuracy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise Alarm usa el micrófono para medir los niveles de sonido ambiental durante el sueño y mejorar la precisión de la detección de fases de sueño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise Alarm usa o microfone para medir os níveis de som ambiente durante o sono e melhorar a precisão da detecção de fases de sono."
          }
        }
      }
    }
  },
  "version": "1.0"
}