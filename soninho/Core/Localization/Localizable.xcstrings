    "tip_dark_room_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use blackout curtains or an eye mask to block light and boost melatonin production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa cortinas opacas o una máscara para bloquear la luz y aumentar la producción de melatonina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use cortinas blackout ou máscara de dormir para bloquear a luz e aumentar a produção de melatonina."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم ستائر معتمة أو قناع عين لحجب الضوء ودعم الميلاتونين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir cortines opaques o un antifaç per bloquejar la llum i afavorir la melatonina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte zatemňovací závěsy nebo masku na oči, abyste zablokovali světlo a podpořili melatonin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug mørklægningsgardiner eller en sovemaske for at blokere lys og fremme melatoninet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Verdunkelungsvorhänge oder eine Schlafmaske, um Licht zu blocken und die Melatoninproduktion zu fördern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε κουρτίνες συσκότισης ή μάσκα ύπνου για να μπλοκάρεις το φως και να ενισχύσεις τη μελατονίνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä pimennysverhoja tai unimaskia estääksesi valon ja tukeaksesi melatoniinia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des rideaux occultants ou un masque de nuit pour bloquer la lumière et favoriser la mélatonine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בווילונות האפלה או מסכת עיניים לחסימת אור ותמיכה במלטונין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोशनी रोकने और मेलाटोनिन बढ़ाने के लिए गहरे पर्दे या आई मास्क इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi zavjese za zamračenje ili masku za oči kako bi blokirao svjetlo i potaknuo melatonin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használj sötétítő függönyt vagy szemmaszkot a fény kizárásához és a melatonin támogatásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan gorden gelap atau penutup mata untuk memblokir cahaya dan mendukung melatonin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tende oscuranti o una mascherina per bloccare la luce e favorire la melatonina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遮光カーテンやアイマスクで光を遮り、メラトニンの分泌を促しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암막 커튼이나 수면 안대로 빛을 차단해 멜라토닌 분비를 도우세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan langsir gelap atau penutup mata untuk menyekat cahaya dan menyokong melatonin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik verduisterende gordijnen of een slaapmasker om licht te blokkeren en melatonine te stimuleren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk blendingsgardiner eller sovemaske for å blokkere lys og støtte melatoninet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj zasłon zaciemniających lub opaski na oczy, aby zablokować światło i wspomóc melatoninę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use cortinas opacas ou uma máscara de dormir para bloquear a luz e favorecer a melatonina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește draperii opace sau o mască de somn pentru a bloca lumina și a susține melatonina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте блэкаут-шторы или маску для сна, чтобы блокировать свет и повысить выработку мелатонина."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite zatemňovacie závesy alebo masku na oči, aby ste zablokovali svetlo a podporili melatonín."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd mörkläggningsgardiner eller sovmask för att blockera ljus och gynna melatoninet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ม่านทึบแสงหรือผ้าปิดตาเพื่อกันแสงและช่วยเมลาโทนิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığı engellemek ve melatonini artırmak için karartma perdesi veya göz maskesi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте щільні штори або маску для сну, щоб блокувати світло і підтримати мелатонін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng rèm chắn sáng hoặc bịt mắt để chặn ánh sáng và hỗ trợ melatonin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用遮光窗帘或眼罩隔绝光线，促进褪黑素分泌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用遮光窗簾或眼罩阻隔光線，促進褪黑激素分泌。"
          }
        }
      }
    },
