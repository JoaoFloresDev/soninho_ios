    "wake_confirm_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get up and take a few steps to finish"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levántate y da unos pasos para terminar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante e dê alguns passos para concluir"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انهض وامشِ بضع خطوات للإنهاء"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva't i fes unes quantes passes per acabar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vstaňte a udělejte pár kroků pro dokončení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå op og tag et par skridt for at afslutte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh auf und geh ein paar Schritte, um abzuschließen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σήκω και κάνε μερικά βήματα για να ολοκληρώσεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouse ylös ja ota muutama askel viimeistelläksesi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levez-vous et faites quelques pas pour terminer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קומו ולכו כמה צעדים כדי לסיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा करने के लिए उठकर कुछ कदम चलें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustani i napravi nekoliko koraka da završiš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelj fel és tegyél néhány lépést a befejezéshez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri dan jalan beberapa langkah untuk menyelesaikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati e fai qualche passo per concludere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起き上がって数歩歩くと完了です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나서 몇 걸음 걸으면 완료됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun dan berjalan beberapa langkah untuk selesai"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta op en zet een paar stappen om af te ronden"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå opp og ta noen skritt for å fullføre"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstań i zrób kilka kroków, aby zakończyć"
          }
        },
        "pt-PT": {
