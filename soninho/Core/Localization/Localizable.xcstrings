    "insight_low_deep_sleep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low deep sleep. Avoid caffeine and exercise before bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poco sueño profundo. Evita cafeína y ejercicio antes de dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouco sono profundo. Evite cafeína e exercícios antes de dormir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النوم العميق قليل. تجنّب الكافيين والرياضة قبل النوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
