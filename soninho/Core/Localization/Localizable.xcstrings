    "tip_daylight_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend at least 30 minutes outside during the day to support your natural sleep-wake cycle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa al menos 30 minutos afuera durante el día para apoyar tu ciclo natural de sueño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe pelo menos 30 minutos ao ar livre durante o dia para apoiar seu ciclo natural de sono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقضِ 30 دقيقة على الأقل في الخارج نهاراً لدعم دورة نومك الطبيعية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa almenys 30 minuts a l'aire lliure durant el dia per donar suport al teu cicle natural de son."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trávte přes den venku alespoň 30 minut, podpoříte tím přirozený cyklus spánku a bdění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær udenfor mindst 30 minutter om dagen for at støtte din naturlige døgnrytme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringe tagsüber mindestens 30 Minuten draußen, um deinen natürlichen Schlaf-Wach-Rhythmus zu unterstützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρνα τουλάχιστον 30 λεπτά έξω τη μέρα για να στηρίξεις τον φυσικό κύκλο ύπνου-αφύπνισης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vietä päivisin vähintään 30 minuuttia ulkona tukeaksesi luonnollista unirytmiäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez au moins 30 minutes dehors dans la journée pour soutenir votre cycle veille-sommeil naturel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלו לפחות 30 דקות בחוץ במהלך היום לתמיכה במחזור השינה הטבעי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राकृतिक नींद चक्र के लिए दिन में कम से कम 30 मिनट बाहर बिताएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provedi barem 30 minuta vani tijekom dana kako bi podržao prirodni ciklus sna i budnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tölts legalább 30 percet a szabadban napközben a természetes alvás-ébrenlét ciklusod támogatásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Habiskan minimal 30 menit di luar ruangan pada siang hari untuk mendukung siklus tidur alami."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascorri almeno 30 minuti all'aperto durante il giorno per sostenere il tuo ciclo naturale sonno-veglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然な睡眠リズムを保つため、日中は30分以上屋外で過ごしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자연스러운 수면-각성 주기를 위해 낮에 최소 30분은 야외에서 보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Luangkan sekurang-kurangnya 30 minit di luar pada siang hari untuk menyokong kitaran tidur semula jadi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng overdag minstens 30 minuten buiten door om je natuurlijke slaap-waakritme te ondersteunen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær ute minst 30 minutter om dagen for å støtte den naturlige døgnrytmen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spędzaj co najmniej 30 minut dziennie na zewnątrz, aby wspierać naturalny rytm snu i czuwania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe pelo menos 30 minutos ao ar livre durante o dia para apoiar o seu ciclo natural de sono."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Petrece cel puțin 30 de minute afară în timpul zilei pentru a-ți susține ciclul natural de somn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проводите на улице не менее 30 минут днём, чтобы поддерживать естественный цикл сна и бодрствования."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trávte cez deň vonku aspoň 30 minút, podporíte tým prirodzený cyklus spánku a bdenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var utomhus minst 30 minuter om dagen för att stödja din naturliga dygnsrytm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกไปข้างนอกอย่างน้อยวันละ 30 นาทีเพื่อช่วยวงจรการนอนตามธรรมชาติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğal uyku-uyanıklık döngünüzü desteklemek için gün içinde en az 30 dakika dışarıda geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проводьте на вулиці щонайменше 30 хвилин на день, щоб підтримувати природний цикл сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành ít nhất 30 phút ngoài trời ban ngày để hỗ trợ chu kỳ ngủ tự nhiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白天至少在户外待 30 分钟，帮助维持自然的睡眠-觉醒周期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白天至少到戶外待 30 分鐘，維持自然的睡眠與清醒週期。"
          }
        }
      }
    },
