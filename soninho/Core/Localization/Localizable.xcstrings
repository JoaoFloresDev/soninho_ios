    "alarm_snooze_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to wake up! Your snooze is over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hora de despertar! Tu siesta terminó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de acordar! Sua soneca acabou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت الاستيقاظ! انتهت الغفوة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de llevar-se! El posposament s'ha acabat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas vstávat! Odklad skončil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til at stå op! Udsættelsen er slut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit zum Aufwachen! Die Schlummerzeit ist vorbei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ώρα να σηκωθείς! Η αναβολή τελείωσε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aika herätä! Torkku on ohi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'heure de se lever ! Le rappel est terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיע הזמן לקום! הנודניק הסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठने का समय! स्नूज़ खत्म हो गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijeme je za ustajanje! Odgoda je gotova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideje felkelni! A szundi lejárt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktunya bangun! Waktu tunda sudah habis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È ora di alzarsi! Il posticipo è finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時間です！スヌーズが終わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어날 시간이에요! 다시 알림이 끝났습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa untuk bangun! Tangguhan sudah tamat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd om op te staan! Je sluimertijd is voorbij."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "På tide å stå opp! Slumringen er over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas wstawać! Drzemka się skończyła."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de acordar! O adiamento terminou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E ora să te trezești! Amânarea s-a terminat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пора вставать! Отсрочка закончилась."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas vstávať! Odklad sa skončil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dags att vakna! Snoozen är över."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้เวลาตื่นแล้ว! หมดเวลาเลื่อนปลุก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanma zamanı! Erteleme süresi doldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час прокидатися! Відкладення завершилося."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ dậy! Hết thời gian báo lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该起床了！稍后提醒时间已结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該起床了！稍後提醒時間已結束。"
          }
        }
      }
    },
