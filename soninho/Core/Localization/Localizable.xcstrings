    "tip_hydration_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink enough water during the day, but reduce intake before bed to minimize nighttime awakenings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bebe suficiente agua durante el día, pero reduce la ingesta antes de dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba água suficiente durante o dia, mas reduza antes de dormir para minimizar despertares."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشرب ماءً كافياً نهاراً، وقلّل قبل النوم لتقليل الاستيقاظ ليلاً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Beu prou aigua durant el dia, però redueix-ne abans de dormir per minimitzar els despertars nocturns."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přes den pijte dostatek vody, před spaním ale méně, ať se v noci nebudíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Drik rigeligt vand i løbet af dagen, men mindre før sengetid for færre natlige opvågninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trink tagsüber genug Wasser, aber reduziere die Menge vor dem Schlafengehen, um nächtliches Aufwachen zu minimieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πίνε αρκετό νερό τη μέρα, αλλά λιγότερο πριν τον ύπνο για λιγότερα νυχτερινά ξυπνήματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Juo päivällä riittävästi vettä, mutta vähennä ennen nukkumaanmenoa öisten heräämisten vähentämiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez assez d'eau dans la journée, mais réduisez avant le coucher pour limiter les réveils nocturnes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתו מספיק מים במהלך היום, אך הפחיתו לפני השינה כדי לצמצם יקיצות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में पर्याप्त पानी पिएँ, पर रात में जागना कम करने के लिए सोने से पहले कम पिएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij dovoljno vode tijekom dana, ali smanji prije spavanja za manje noćnih buđenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napközben igyál elég vizet, de lefekvés előtt kevesebbet, hogy éjjel ritkábban ébredj fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum cukup air di siang hari, tapi kurangi sebelum tidur agar tidak sering terbangun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevi abbastanza acqua durante il giorno, ma riduci prima di dormire per limitare i risvegli notturni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日中は十分に水分を取り、就寝前は控えめにして夜中の目覚めを減らしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮에는 물을 충분히 마시되, 자기 전에는 줄여서 밤중에 깨는 일을 줄이세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minum air secukupnya pada siang hari, tetapi kurangkan sebelum tidur untuk mengurangkan terjaga malam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink overdag genoeg water, maar minder vlak voor bed om nachtelijk wakker worden te beperken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Drikk nok vann i løpet av dagen, men mindre før leggetid for færre nattlige oppvåkninger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pij wystarczająco wody w ciągu dnia, ale mniej przed snem, aby ograniczyć nocne pobudki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Beba água suficiente durante o dia, mas reduza antes de deitar para minimizar despertares noturnos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bea suficientă apă în timpul zilei, dar redu cantitatea înainte de culcare pentru mai puține treziri nocturne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пейте достаточно воды днём, но меньше перед сном, чтобы реже просыпаться ночью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cez deň pite dosť vody, pred spaním však menej, aby ste sa v noci nebudili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Drick tillräckligt med vatten under dagen, men mindre före läggdags för färre nattliga uppvaknanden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดื่มน้ำให้พอตอนกลางวัน แต่ลดก่อนนอนเพื่อลดการตื่นกลางดึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün boyunca yeterince su için; gece uyanmalarını azaltmak için yatmadan önce azaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пийте достатньо води вдень, але менше перед сном, щоб рідше прокидатися вночі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống đủ nước ban ngày, nhưng giảm trước giờ ngủ để bớt thức giấc ban đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白天喝足水，但睡前减少饮水，避免夜间醒来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白天喝足水，睡前減少飲水，減少夜間醒來。"
          }
        }
      }
    },
