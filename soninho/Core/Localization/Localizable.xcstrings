    "tip_caffeine_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid caffeine at least 6 hours before bedtime. It can stay in your system for hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la cafeína al menos 6 horas antes de dormir. Puede permanecer en tu sistema por horas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite cafeína pelo menos 6 horas antes de dormir. Ela pode permanecer no seu sistema por horas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنّب الكافيين قبل النوم بـ6 ساعات على الأقل. قد يبقى في الجسم لساعات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la cafeïna almenys 6 hores abans d'anar a dormir. Pot romandre hores al cos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhněte se kofeinu alespoň 6 hodin před spaním. V těle může působit celé hodiny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå koffein mindst 6 timer før sengetid. Det kan blive i kroppen i timevis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Koffein mindestens 6 Stunden vor dem Schlafengehen. Es kann stundenlang im Körper bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόφυγε την καφεΐνη τουλάχιστον 6 ώρες πριν τον ύπνο. Μπορεί να μείνει ώρες στον οργανισμό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä kofeiinia vähintään 6 tuntia ennen nukkumaanmenoa. Se voi vaikuttaa tunteja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez la caféine au moins 6 heures avant le coucher. Elle peut rester des heures dans l'organisme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הימנעו מקפאין לפחות 6 שעות לפני השינה. הוא נשאר בגוף שעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से कम से कम 6 घंटे पहले कैफ़ीन से बचें। यह शरीर में घंटों रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbjegavaj kofein najmanje 6 sati prije spavanja. Može djelovati satima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerüld a koffeint legalább 6 órával lefekvés előtt. Órákig a szervezetben maradhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindari kafein setidaknya 6 jam sebelum tidur. Kafein bisa bertahan berjam-jam di tubuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la caffeina almeno 6 ore prima di dormire. Può restare in circolo per ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝の6時間前からはカフェインを避けましょう。体内に数時間残ることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 최소 6시간 전부터 카페인을 피하세요. 몸에 몇 시간 동안 남아 있을 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Elakkan kafein sekurang-kurangnya 6 jam sebelum tidur. Ia boleh kekal berjam-jam dalam badan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd cafeïne minstens 6 uur voor bedtijd. Het kan uren in je lichaam blijven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå koffein minst 6 timer før leggetid. Det kan bli i kroppen i timevis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj kofeiny co najmniej 6 godzin przed snem. Może działać jeszcze przez wiele godzin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite cafeína pelo menos 6 horas antes de deitar. Pode permanecer no organismo durante horas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evită cafeina cu cel puțin 6 ore înainte de culcare. Poate rămâne ore întregi în organism."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте кофеина минимум за 6 часов до сна. Он может действовать часами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhnite sa kofeínu aspoň 6 hodín pred spaním. V tele môže pôsobiť celé hodiny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik koffein minst 6 timmar före läggdags. Det kan stanna i kroppen i timmar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลี่ยงคาเฟอีนอย่างน้อย 6 ชั่วโมงก่อนนอน เพราะอยู่ในร่างกายได้หลายชั่วโมง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan en az 6 saat önce kafeinden kaçının. Vücutta saatlerce kalabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникайте кофеїну щонайменше за 6 годин до сну. Він може діяти годинами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh caffeine ít nhất 6 tiếng trước giờ ngủ. Nó có thể tồn tại trong cơ thể nhiều giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前至少 6 小时避免咖啡因。它会在体内停留数小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前至少 6 小時避免咖啡因。它可能在體內停留數小時。"
          }
        }
      }
    },
