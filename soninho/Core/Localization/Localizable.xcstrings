    "tracker_step3_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you wake up, tap Wake Up to see your quality score and detailed report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al despertar, toca Despertar para ver tu puntuación de calidad e informe detallado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao acordar, toque em Acordar para ver sua pontuação de qualidade e relatório detalhado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الاستيقاظ، اضغط استيقاظ لترى نتيجتك وتقريرك المفصّل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan et despertis, toca Desperta't per veure la teva puntuació i l'informe detallat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po probuzení klepněte na Vzbudit se a podívejte se na své skóre a podrobný report."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vågner, skal du trykke på Vågn op for at se din score og den detaljerede rapport."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du aufwachst, tippe auf Aufwachen und sieh deine Bewertung und den detaillierten Bericht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ξυπνήσεις, πάτα Ξύπνημα για να δεις τη βαθμολογία και τη λεπτομερή αναφορά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun heräät, napauta Herää nähdäksesi pisteesi ja tarkan raportin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au réveil, touchez Se réveiller pour voir votre score et votre rapport détaillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשאתם קמים, הקישו על השכמה כדי לראות את הציון והדוח המפורט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठने पर स्कोर और विस्तृत रिपोर्ट देखने के लिए 'जागें' दबाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad se probudiš, dodirni Probudi se za ocjenu i detaljan izvještaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébredéskor koppints az Ébredés gombra a pontszámodért és a részletes jelentésért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bangun, ketuk Bangun untuk melihat skor dan laporan mendetail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al risveglio, tocca Svegliati per vedere il tuo punteggio e il report dettagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きたら「起きる」をタップして、スコアと詳しいレポートを確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나면 '기상'을 눌러 수면 점수와 상세 리포트를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila bangun, ketik Bangun untuk melihat skor dan laporan terperinci anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik bij het wakker worden op Word wakker om je score en het gedetailleerde rapport te zien."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du våkner, trykker du på Våkn opp for å se poengsummen din og den detaljerte rapporten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po przebudzeniu dotknij Pobudka, aby zobaczyć ocenę i szczegółowy raport."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao acordar, toque em Acordar para ver a sua pontuação e o relatório detalhado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când te trezești, atinge Trezește-te ca să vezi scorul și raportul detaliat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проснувшись, нажмите «Проснуться», чтобы увидеть оценку и подробный отчёт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zobudení klepnite na Zobudiť sa a pozrite si svoje skóre a podrobný report."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du vaknar trycker du på Vakna för att se ditt betyg och den detaljerade rapporten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตื่น แตะ ตื่นนอน เพื่อดูคะแนนและรายงานละเอียด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanınca Uyan'a dokunun; kalite puanınızı ve ayrıntılı raporu görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокинувшись, натисніть «Прокинутися», щоб побачити оцінку і детальний звіт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tỉnh dậy, nhấn Thức dậy để xem điểm số và báo cáo chi tiết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "醒来后点击「起床」，查看你的质量评分和详细报告。"
          }
        },
        "zh-Hant": {
