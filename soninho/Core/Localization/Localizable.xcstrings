            "state": "translated",
            "value": "몇 분 뒤에 만나요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumpa beberapa minit lagi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot over een paar minuten"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses om noen minutter"
          }
        },
        "pl": {
