    "tip_quiet_room_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use earplugs or white noise to create a quiet sleep environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tapones o ruido blanco para crear un ambiente tranquilo para dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use protetores auriculares ou ruído branco para criar um ambiente silencioso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم سدادات أذن أو ضوضاء بيضاء لبيئة نوم هادئة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir taps per a les orelles o soroll blanc per crear un entorn silenciós."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte špunty do uší nebo bílý šum pro tiché prostředí na spaní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug ørepropper eller hvid støj for at skabe et stille sovemiljø."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Ohrstöpsel oder weißes Rauschen für eine ruhige Schlafumgebung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε ωτοασπίδες ή λευκό θόρυβο για ένα ήσυχο περιβάλλον ύπνου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä korvatulppia tai valkoista kohinaa luodaksesi hiljaisen nukkumisympäristön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des bouchons d'oreilles ou un bruit blanc pour créer un environnement calme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו באטמי אוזניים או רעש לבן לסביבת שינה שקטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत नींद के माहौल के लिए इयरप्लग या व्हाइट नॉइज़ इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi čepiće za uši ili bijeli šum za tiho okruženje za spavanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használj füldugót vagy fehér zajt a csendes alvási környezethez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan penyumbat telinga atau white noise untuk lingkungan tidur yang tenang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tappi per le orecchie o rumore bianco per creare un ambiente silenzioso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "耳栓やホワイトノイズで静かな睡眠環境をつくりましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀마개나 백색소음으로 조용한 수면 환경을 만드세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan penyumbat telinga atau bunyi putih untuk persekitaran tidur yang senyap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik oordoppen of witte ruis voor een stille slaapomgeving."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk ørepropper eller hvit støy for å skape et stille sovemiljø."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj zatyczek do uszu lub białego szumu, aby stworzyć ciche otoczenie do snu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use tampões para os ouvidos ou ruído branco para criar um ambiente silencioso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește dopuri de urechi sau zgomot alb pentru un mediu de somn liniștit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте беруши или белый шум, чтобы создать тихую обстановку для сна."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite štuple do uší alebo biely šum pre tiché prostredie na spanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd öronproppar eller vitt brus för en tyst sovmiljö."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ที่อุดหูหรือไวท์นอยส์เพื่อสภาพแวดล้อมการนอนที่เงียบสงบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz bir uyku ortamı için kulak tıkacı veya beyaz gürültü kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте беруші або білий шум, щоб створити тихе середовище для сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng nút bịt tai hoặc tiếng ồn trắng để có không gian ngủ yên tĩnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用耳塞或白噪音，营造安静的睡眠环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用耳塞或白噪音，打造安靜的睡眠環境。"
          }
        }
      }
    },
