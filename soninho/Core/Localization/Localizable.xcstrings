    "tip_consistent_schedule_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to bed and wake up at the same time every day, even on weekends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuéstate y despierta a la misma hora todos los días, incluso los fines de semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durma e acorde no mesmo horário todos os dias, mesmo nos fins de semana."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نم واستيقظ في نفس الوقت كل يوم، حتى في عطلة نهاية الأسبوع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves a dormir i lleva't a la mateixa hora cada dia, també els caps de setmana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Choďte spát a vstávejte každý den ve stejnou dobu, i o víkendech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå i seng og stå op på samme tidspunkt hver dag, også i weekenden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh jeden Tag zur gleichen Zeit ins Bett und steh zur gleichen Zeit auf, auch am Wochenende."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κοιμήσου και ξύπνα την ίδια ώρα κάθε μέρα, ακόμα και τα σαββατοκύριακα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mene nukkumaan ja herää samaan aikaan joka päivä, myös viikonloppuisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couchez-vous et levez-vous à la même heure chaque jour, même le week-end."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכו לישון וקומו באותה שעה כל יום, גם בסופי שבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन एक ही समय पर सोएँ और उठें, सप्ताहांत में भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liježi i ustaj u isto vrijeme svaki dan, čak i vikendom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Feküdj le és kelj fel minden nap ugyanakkor, hétvégén is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur dan bangun di jam yang sama setiap hari, termasuk akhir pekan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai a letto e svegliati alla stessa ora ogni giorno, anche nel weekend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末も含めて、毎日同じ時間に寝て同じ時間に起きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말에도 매일 같은 시간에 자고 같은 시간에 일어나세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidur dan bangun pada waktu yang sama setiap hari, termasuk hujung minggu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga elke dag op dezelfde tijd naar bed en sta op dezelfde tijd op, ook in het weekend."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg deg og stå opp til samme tid hver dag, også i helgene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kładź się i wstawaj o tej samej porze każdego dnia, także w weekendy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se e levante-se à mesma hora todos os dias, mesmo ao fim de semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culcă-te și trezește-te la aceeași oră în fiecare zi, chiar și în weekend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ложитесь и вставайте в одно и то же время каждый день, даже в выходные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Choďte spať a vstávajte každý deň v rovnakom čase, aj cez víkendy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå och lägg dig och vakna vid samma tid varje dag, även på helger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้านอนและตื่นเวลาเดิมทุกวัน รวมถึงวันหยุดสุดสัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta sonları dahil her gün aynı saatte yatın ve kalkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лягайте і прокидайтеся в один і той самий час щодня, навіть у вихідні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi ngủ và thức dậy cùng một giờ mỗi ngày, kể cả cuối tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在同一时间上床和起床，周末也不例外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
