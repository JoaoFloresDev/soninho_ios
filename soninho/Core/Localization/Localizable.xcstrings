          "stringUnit": {
            "state": "translated",
            "value": "Beperk het sluimeren om echt op tijd op te staan"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrens slumringer så du faktisk kommer deg opp i tide"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicz drzemki, żeby naprawdę wstawać na czas"
          }
        },
        "pt-PT": {
          "stringUnit": {
