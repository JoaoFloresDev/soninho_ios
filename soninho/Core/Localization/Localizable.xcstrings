    "tracker_step1_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button below and place your phone near your pillow before sleeping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de abajo y coloca tu teléfono cerca de la almohada antes de dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão abaixo e coloque o celular perto do travesseiro antes de dormir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط الزر أدناه وضع الآيفون قرب الوسادة قبل النوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botó de sota i posa l'iPhone al costat del coixí abans de dormir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na tlačítko níže a před spaním položte iPhone vedle polštáře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på knappen nedenfor og læg din iPhone ved siden af puden, før du sover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten auf den Button und lege dein iPhone vor dem Einschlafen neben dein Kissen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα το κουμπί παρακάτω και βάλε το iPhone δίπλα στο μαξιλάρι πριν κοιμηθείς."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta alla olevaa painiketta ja aseta iPhone tyynyn viereen ennen nukahtamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton ci-dessous et posez votre iPhone près de l'oreiller avant de dormir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על הכפתור למטה והניחו את האייפון ליד הכרית לפני השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे का बटन दबाएँ और सोने से पहले iPhone तकिये के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni gumb ispod i stavi iPhone pokraj jastuka prije spavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a lenti gombra, és tedd az iPhone-t a párnád mellé elalvás előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol di bawah dan letakkan iPhone di dekat bantal sebelum tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante qui sotto e appoggia l'iPhone vicino al cuscino prima di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のボタンをタップして、寝る前にiPhoneを枕の近くに置きましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 버튼을 누르고 자기 전에 iPhone을 베개 근처에 두세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik butang di bawah dan letakkan iPhone berhampiran bantal sebelum tidur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knop hieronder en leg je iPhone naast je kussen voordat je gaat slapen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på knappen nedenfor og legg iPhonen ved siden av puta før du sover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij przycisku poniżej i połóż iPhone'a przy poduszce przed snem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão abaixo e coloque o iPhone junto à almofada antes de dormir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge butonul de mai jos și pune iPhone-ul lângă pernă înainte de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку ниже и положите iPhone рядом с подушкой перед сном."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na tlačidlo nižšie a pred spaním položte iPhone vedľa vankúša."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på knappen nedan och lägg din iPhone nära kudden innan du somnar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มด้านล่างแล้ววาง iPhone ไว้ใกล้หมอนก่อนนอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki düğmeye dokunun ve uyumadan önce iPhone'unuzu yastığınızın yanına koyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку нижче і покладіть iPhone біля подушки перед сном."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn nút bên dưới và đặt iPhone gần gối trước khi ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方按钮，睡前把手机放在枕头附近。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下下方按鈕，睡前把手機放在枕頭附近。"
          }
        }
      }
    },
