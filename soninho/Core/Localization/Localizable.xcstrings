    "tip_screen_time_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid screens 1 hour before bed. Blue light suppresses melatonin production."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita las pantallas 1 hora antes de dormir. La luz azul suprime la producción de melatonina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite telas 1 hora antes de dormir. A luz azul suprime a produção de melatonina."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنّب الشاشات قبل النوم بساعة. الضوء الأزرق يثبّط إنتاج الميلاتونين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita les pantalles 1 hora abans de dormir. La llum blava inhibeix la producció de melatonina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinu před spaním se vyhněte obrazovkám. Modré světlo potlačuje tvorbu melatoninu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå skærme 1 time før sengetid. Blåt lys hæmmer produktionen af melatonin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Bildschirme 1 Stunde vor dem Schlafengehen. Blaues Licht unterdrückt die Melatoninproduktion."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόφυγε τις οθόνες 1 ώρα πριν τον ύπνο. Το μπλε φως καταστέλλει τη μελατονίνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä näyttöjä tunti ennen nukkumaanmenoa. Sininen valo estää melatoniinin eritystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les écrans 1 heure avant le coucher. La lumière bleue freine la production de mélatonine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הימנעו ממסכים שעה לפני השינה. אור כחול מדכא ייצור מלטונין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से 1 घंटा पहले स्क्रीन से बचें। नीली रोशनी मेलाटोनिन बनना रोकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbjegavaj ekrane sat vremena prije spavanja. Plavo svjetlo potiskuje melatonin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerüld a képernyőket lefekvés előtt 1 órával. A kék fény gátolja a melatonintermelést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindari layar 1 jam sebelum tidur. Cahaya biru menekan produksi melatonin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita gli schermi 1 ora prima di dormire. La luce blu inibisce la produzione di melatonina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝1時間前から画面を避けましょう。ブルーライトはメラトニンの分泌を抑えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 1시간 전부터 화면을 피하세요. 블루라이트는 멜라토닌 분비를 억제합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Elakkan skrin 1 jam sebelum tidur. Cahaya biru menyekat penghasilan melatonin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd schermen 1 uur voor bedtijd. Blauw licht remt de aanmaak van melatonine."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå skjermer 1 time før leggetid. Blått lys hemmer melatoninproduksjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj ekranów na godzinę przed snem. Niebieskie światło hamuje wydzielanie melatoniny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite ecrãs na hora antes de deitar. A luz azul inibe a produção de melatonina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evită ecranele cu o oră înainte de culcare. Lumina albastră inhibă producția de melatonină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте экранов за час до сна. Синий свет подавляет выработку мелатонина."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodinu pred spaním sa vyhnite obrazovkám. Modré svetlo potláča tvorbu melatonínu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik skärmar 1 timme före läggdags. Blått ljus hämmar melatoninproduktionen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลี่ยงหน้าจอ 1 ชั่วโมงก่อนนอน แสงสีฟ้ายับยั้งการสร้างเมลาโทนิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan 1 saat önce ekranlardan uzak durun. Mavi ışık melatonin üretimini baskılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникайте екранів за годину до сну. Синє світло пригнічує вироблення мелатоніну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh màn hình 1 tiếng trước giờ ngủ. Ánh sáng xanh ức chế melatonin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 1 小时远离屏幕。蓝光会抑制褪黑素分泌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 1 小時遠離螢幕。藍光會抑制褪黑激素分泌。"
          }
        }
      }
    },
