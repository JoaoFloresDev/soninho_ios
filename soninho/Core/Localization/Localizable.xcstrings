    "tip_morning_light_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose yourself to sunlight within 30 minutes of waking up to regulate your circadian rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponte a la luz solar dentro de los 30 minutos después de despertar para regular tu ritmo circadiano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponha-se à luz solar nos primeiros 30 minutos após acordar para regular seu ritmo circadiano."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّض لضوء الشمس خلال 30 دقيقة من الاستيقاظ لضبط إيقاعك اليومي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposa't a la llum del sol durant els primers 30 minuts després de despertar-te per regular el ritme circadiari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 30 minut po probuzení se vystavte slunečnímu světlu, srovnáte tím cirkadiánní rytmus."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg sollys inden for 30 minutter efter du vågner for at regulere din døgnrytme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setz dich innerhalb von 30 Minuten nach dem Aufwachen dem Sonnenlicht aus, um deinen zirkadianen Rhythmus zu regulieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγες στο φως του ήλιου μέσα σε 30 λεπτά από το ξύπνημα για να ρυθμίσεις το βιολογικό σου ρολόι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakeudu auringonvaloon 30 minuutin sisällä heräämisestä säätääksesi vuorokausirytmiäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposez-vous à la lumière du soleil dans les 30 minutes après le réveil pour réguler votre rythme circadien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלו אור שמש תוך 30 דקות מהיקיצה לוויסות השעון הביולוגי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जागने के 30 मिनट के भीतर धूप लें - आपकी बॉडी क्लॉक सधती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izloži se sunčevoj svjetlosti unutar 30 minuta od buđenja kako bi regulirao cirkadijalni ritam."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébredés után 30 percen belül menj napfényre a cirkadián ritmusod beállításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpapar sinar matahari dalam 30 menit setelah bangun membantu mengatur ritme sirkadian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esponiti alla luce del sole entro 30 minuti dal risveglio per regolare il tuo ritmo circadiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床後30分以内に日光を浴びて、体内時計を整えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 후 30분 이내에 햇빛을 쬐어 생체 리듬을 조절하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan cahaya matahari dalam 30 minit selepas bangun untuk mengatur ritma sirkadian anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek binnen 30 minuten na het opstaan zonlicht op om je circadiane ritme te reguleren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk sollys innen 30 minutter etter at du våkner for å regulere døgnrytmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjdź na słońce w ciągu 30 minut od pobudki, aby uregulować rytm dobowy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponha-se à luz do sol nos primeiros 30 minutos depois de acordar para regular o ritmo circadiano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Expune-te la lumina soarelui în primele 30 de minute după trezire pentru a-ți regla ritmul circadian."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходите на солнечный свет в первые 30 минут после подъёма, чтобы настроить циркадный ритм."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 30 minút po zobudení sa vystavte slnečnému svetlu, zladíte tým cirkadiánny rytmus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sök solljus inom 30 minuter efter uppvaknandet för att reglera din dygnsrytm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับแสงแดดภายใน 30 นาทีหลังตื่นเพื่อปรับนาฬิกาชีวิต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirkadiyen ritminizi düzenlemek için uyandıktan sonraki 30 dakika içinde güneş ışığına çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виходьте на сонячне світло в перші 30 хвилин після пробудження, щоб налаштувати циркадний ритм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đón ánh nắng trong 30 phút sau khi dậy để điều chỉnh nhịp sinh học."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床后 30 分钟内晒晒太阳，帮助调节昼夜节律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起床後 30 分鐘內曬曬太陽，幫助調節生理時鐘。"
          }
        }
      }
    },
