    "tip_heavy_meals_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't eat large meals within 2-3 hours of bedtime to avoid digestive discomfort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No comas comidas grandes 2-3 horas antes de dormir para evitar molestias digestivas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não coma refeições grandes 2-3 horas antes de dormir para evitar desconforto digestivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تأكل وجبات ثقيلة قبل النوم بـ2-3 ساعات لتجنّب مشاكل الهضم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No facis àpats copiosos 2-3 hores abans de dormir per evitar molèsties digestives."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejezte velká jídla 2–3 hodiny před spaním, předejdete zažívacím potížím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spis ikke store måltider 2-3 timer før sengetid for at undgå fordøjelsesbesvær."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Iss keine großen Mahlzeiten in den letzten 2–3 Stunden vor dem Schlafengehen, um Verdauungsbeschwerden zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην τρως μεγάλα γεύματα 2-3 ώρες πριν τον ύπνο για να αποφύγεις δυσφορία στην πέψη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä raskaita aterioita 2–3 tuntia ennen nukkumaanmenoa vatsavaivojen välttämiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les repas copieux dans les 2 à 3 heures avant le coucher pour prévenir l'inconfort digestif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תאכלו ארוחות כבדות 2-3 שעות לפני השינה כדי למנוע בעיות עיכול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाचन समस्याओं से बचने के लिए सोने से 2-3 घंटे पहले भारी भोजन न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jedi obilne obroke 2-3 sata prije spavanja kako bi izbjegao probavne smetnje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne egyél nagy étkezéseket lefekvés előtt 2-3 órával, hogy elkerüld az emésztési panaszokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan makan besar 2-3 jam sebelum tidur agar pencernaan tidak terganggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita pasti abbondanti nelle 2-3 ore prima di dormire per prevenire fastidi digestivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消化の負担を避けるため、就寝2〜3時間前の大量の食事は控えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소화 불편을 피하려면 취침 2~3시간 전에는 과식을 피하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan makan berat 2-3 jam sebelum tidur untuk mengelakkan masalah penghadaman."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eet geen grote maaltijden binnen 2-3 uur voor bedtijd om spijsverteringsklachten te voorkomen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå store måltider 2–3 timer før leggetid for å unngå fordøyelsesplager."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jedz obfitych posiłków na 2–3 godziny przed snem, aby uniknąć dyskomfortu trawiennego."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite refeições pesadas nas 2 a 3 horas antes de deitar para prevenir desconforto digestivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu mânca mese copioase cu 2-3 ore înainte de culcare, ca să eviți disconfortul digestiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ешьте плотно за 2–3 часа до сна, чтобы избежать дискомфорта в желудке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejedzte veľké jedlá 2 – 3 hodiny pred spaním, predídete tráviacim ťažkostiam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ät inte stora måltider 2–3 timmar före läggdags för att undvika magbesvär."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งดมื้อหนัก 2-3 ชั่วโมงก่อนนอนเพื่อเลี่ยงปัญหาการย่อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sindirim rahatsızlığını önlemek için yatmadan 2-3 saat önce ağır yemeklerden kaçının."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не їжте важкої їжі за 2–3 години до сну, щоб уникнути дискомфорту в шлунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ăn nặng 2-3 tiếng trước giờ ngủ để tránh khó tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 2-3 小时内不要吃大餐，以免肠胃不适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 2-3 小時內別吃大餐，以免腸胃不適。"
          }
        }
      }
    },
