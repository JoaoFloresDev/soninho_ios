    "onboarding_subtitle_1": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand your sleep patterns with detailed analysis of deep, light, and REM sleep stages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprende tus patrones de sueño con análisis detallado de las fases de sueño profundo, ligero y REM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entenda seus padrões de sono com análise detalhada das fases de sono profundo, leve e REM."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افهم أنماط نومك بتحليل مفصّل لمراحل النوم العميق والخفيف وحركة العين السريعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entén els teus patrons de son amb una anàlisi detallada de les fases profunda, lleugera i REM."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porozumějte svým spánkovým návykům díky podrobné analýze hlubokého, lehkého a REM spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forstå dine søvnmønstre med detaljeret analyse af dyb, let og REM-søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstehe deine Schlafmuster mit detaillierter Analyse von Tiefschlaf-, Leichtschlaf- und REM-Phasen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατανόησε τα μοτίβα του ύπνου σου με λεπτομερή ανάλυση βαθέος, ελαφρού και REM ύπνου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymmärrä unirytmiäsi syvän unen, kevyen unen ja REM-unen yksityiskohtaisen analyysin avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprenez vos habitudes de sommeil grâce à une analyse détaillée des phases profondes, légères et paradoxales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבינו את דפוסי השינה שלכם עם ניתוח מפורט של שינה עמוקה, קלה ו-REM."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गहरी, हल्की और REM नींद के विस्तृत विश्लेषण से अपने नींद पैटर्न समझें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upoznaj svoje obrasce spavanja uz detaljnu analizu dubokog, laganog i REM sna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ismerd meg az alvási szokásaidat a mély, könnyű és REM-fázisok részletes elemzésével."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahami pola tidurmu dengan analisis mendetail tahap tidur nyenyak, ringan, dan REM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprendi i tuoi schemi di sonno con un'analisi dettagliata delle fasi profonda, leggera e REM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深い睡眠・浅い睡眠・レム睡眠の詳しい分析で、あなたの睡眠パターンを理解しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊은 수면, 얕은 수면, 렘수면 단계의 상세 분석으로 수면 패턴을 이해하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahami corak tidur anda dengan analisis terperinci peringkat tidur lena, ringan dan REM."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrijp je slaappatronen met gedetailleerde analyse van diepe, lichte en REM-slaapfasen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Forstå søvnmønstrene dine med detaljert analyse av dyp, lett og REM-søvn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj swoje wzorce snu dzięki szczegółowej analizie faz głębokiej, lekkiej i REM."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compreenda os seus padrões de sono com uma análise detalhada das fases profunda, leve e REM."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înțelege-ți tiparele de somn cu o analiză detaliată a fazelor profundă, ușoară și REM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбирайтесь в своём сне благодаря подробному анализу глубокой, лёгкой и БДГ-фаз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoznajte svoje spánkové návyky vďaka podrobnej analýze hlbokého, ľahkého a REM spánku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förstå dina sömnmönster med detaljerad analys av djup, lätt och REM-sömn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าใจรูปแบบการนอนของคุณด้วยการวิเคราะห์ระยะหลับลึก หลับตื้น และ REM อย่างละเอียด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derin, hafif ve REM uyku evrelerinin ayrıntılı analiziyle uyku düzeninizi anlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розумійте свої патерни сну завдяки детальному аналізу глибокої, легкої та REM-фаз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiểu rõ giấc ngủ của bạn với phân tích chi tiết các giai đoạn ngủ sâu, nông và REM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过对深睡、浅睡和 REM 各阶段的详细分析，了解你的睡眠模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過深眠、淺眠與 REM 各階段的詳細分析，了解你的睡眠模式。"
          }
        }
      }
    },
    "onboarding_subtitle_2": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your sleep quality trends, average bedtime, and how your sleep improves over time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve las tendencias de calidad del sueño, hora promedio de dormir y cómo mejora tu sueño con el tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja tendências de qualidade do sono, horário médio de dormir e como seu sono melhora com o tempo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع اتجاهات جودة نومك ومتوسط وقت النوم وتحسّن نومك مع مرور الوقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta les tendències de qualitat del son, l'hora mitjana d'anar a dormir i la teva millora amb el temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte trendy kvality spánku, průměrný čas usínání a svůj pokrok v čase."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tendenser i din søvnkvalitet, din gennemsnitlige sengetid og din udvikling over tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deine Schlafqualitätstrends, deine durchschnittliche Schlafenszeit und wie sich dein Schlaf verbessert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες τις τάσεις ποιότητας ύπνου, τη μέση ώρα ύπνου και τη βελτίωσή σου στον χρόνο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näe unenlaadun trendit, keskimääräinen nukkumaanmenoaikasi ja kehityksesi ajan mittaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos tendances de qualité de sommeil, votre heure moyenne de coucher et vos progrès au fil du temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחרי מגמות איכות השינה, שעת השינה הממוצעת והשיפור לאורך זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ नींद की गुणवत्ता, औसत सोने का समय और सुधार देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati trendove kvalitete sna, prosječno vrijeme lijeganja i svoj napredak kroz vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd az alvásminőség trendjeit, az átlagos lefekvési idődet és a fejlődésedet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat tren kualitas tidur, rata-rata jam tidur, dan bagaimana tidurmu membaik dari waktu ke waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva le tendenze della qualità del sonno, l'orario medio in cui vai a letto e i tuoi progressi nel tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の質の推移、平均就寝時刻、そして睡眠の改善を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 질 추이, 평균 취침 시간, 그리고 수면이 개선되는 과정을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat trend kualiti tidur, purata waktu tidur dan peningkatan tidur anda dari semasa ke semasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk trends in je slaapkwaliteit, je gemiddelde bedtijd en hoe je slaap in de loop van de tijd verbetert."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Se trender i søvnkvaliteten, gjennomsnittlig leggetid og hvordan søvnen din utvikler seg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź trendy jakości snu, średnią porę kładzenia się i postępy w czasie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as tendências da qualidade do sono, a hora média de deitar e a sua evolução ao longo do tempo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește tendințele calității somnului, ora medie de culcare și progresul tău în timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за качеством сна, средним временем отхода ко сну и прогрессом со временем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte trendy kvality spánku, priemerný čas zaspávania a svoj pokrok v čase."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se trender i sömnkvalitet, genomsnittlig läggdags och hur din sömn förbättras över tid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูแนวโน้มคุณภาพการนอน เวลานอนเฉลี่ย และพัฒนาการของคุณเมื่อเวลาผ่านไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku kalitesi trendlerinizi, ortalama yatma saatinizi ve zamanla gelişiminizi görün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стежте за якістю сну, середнім часом засинання та прогресом із часом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi xu hướng chất lượng giấc ngủ, giờ ngủ trung bình và tiến bộ theo thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看睡眠质量趋势、平均就寝时间，以及你的睡眠如何随时间改善。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看睡眠品質趨勢、平均就寢時間，以及你的睡眠如何隨時間進步。"
          }
        }
      }
    },
    "onboarding_subtitle_3": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake up at the optimal moment during light sleep for a refreshed and energized morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despierta en el momento óptimo durante el sueño ligero para una mañana fresca y llena de energía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorde no momento ideal durante o sono leve para uma manhã revigorada e energizada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظ في اللحظة المثالية أثناء النوم الخفيف لصباح منتعش ونشيط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desperta't en el moment òptim del son lleuger per a un matí fresc i ple d'energia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probuďte se v optimální chvíli lehkého spánku a mějte svěží ráno plné energie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågn op på det optimale tidspunkt under let søvn og få en frisk morgen fuld af energi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach im optimalen Moment im leichten Schlaf auf, für einen frischen, energiegeladenen Morgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξύπνα στην ιδανική στιγμή του ελαφρού ύπνου για ένα φρέσκο πρωινό γεμάτο ενέργεια."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herää optimaalisella hetkellä kevyessä unessa – virkeään ja energiseen aamuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveillez-vous au moment optimal, en sommeil léger, pour un matin frais et plein d'énergie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התעוררו ברגע המושלם בשנת השינה הקלה לבוקר רענן ומלא אנרגיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताज़गी भरी सुबह के लिए हल्की नींद के सही पल में जागें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probudi se u optimalnom trenutku laganog sna za svježe jutro puno energije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébredj a könnyű alvás optimális pillanatában egy friss, energikus reggelért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun di momen optimal saat tidur ringan untuk pagi yang segar dan berenergi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svegliati nel momento ottimale durante il sonno leggero, per un mattino fresco e pieno di energia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "浅い眠りの最適なタイミングで起きて、すっきりした朝を迎えましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얕은 수면 중 최적의 순간에 깨어나 상쾌하고 활기찬 아침을 맞으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun pada saat optimum semasa tidur ringan untuk pagi yang segar dan bertenaga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Word wakker op het optimale moment tijdens lichte slaap, voor een frisse en energieke ochtend."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Våkn opp i det optimale øyeblikket i lett søvn for en frisk morgen full av energi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budź się w optymalnym momencie lekkiego snu — na świeży, pełen energii poranek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorde no momento ideal durante o sono leve, para uma manhã fresca e cheia de energia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezește-te în momentul optim din somnul ușor, pentru o dimineață proaspătă și plină de energie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просыпайтесь в оптимальный момент лёгкого сна — утро будет бодрым и свежим."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobuďte sa v optimálnej chvíli ľahkého spánku a majte svieže ráno plné energie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakna i det optimala ögonblicket under lätt sömn för en pigg och energifylld morgon."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตื่นในจังหวะที่ดีที่สุดช่วงหลับตื้น เพื่อเช้าที่สดชื่นเต็มพลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif uykudaki en uygun anda uyanın; sabaha zinde ve enerjik başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокидайтеся в оптимальний момент легкого сну — ранок буде свіжим і бадьорим."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thức dậy vào thời điểm hoàn hảo trong giấc ngủ nông để buổi sáng sảng khoái, tràn đầy năng lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浅睡阶段的最佳时刻醒来，迎接精力充沛的清爽早晨。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在淺眠的最佳時刻醒來，迎接神清氣爽、充滿活力的早晨。"
          }
        }
      }
    },
