    "wake_gradual_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade volume and light in, sunrise style"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube volumen y luz poco a poco, estilo amanecer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobe volume e luz aos poucos, estilo nascer do sol"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزداد الصوت والضوء تدريجياً، مثل شروق الشمس"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El volum i la llum pugen suaument, com una sortida de sol"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitost a světlo sílí pozvolna jako východ slunce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydstyrke og lys stiger blidt, som en solopgang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke und Licht steigen sanft an, wie ein Sonnenaufgang"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ένταση και το φως δυναμώνουν απαλά, σαν ανατολή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni ja valo voimistuvat pehmeästi kuin auringonnousu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume et la lumière montent en douceur, comme un lever de soleil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העוצמה והאור גוברים בהדרגה, כמו זריחה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ और रोशनी धीरे-धीरे बढ़ती हैं, सूर्योदय की तरह"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasnoća i svjetlo nježno rastu, poput izlaska sunca"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangerő és a fény lágyan erősödik, mint egy napkelte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume dan cahaya naik perlahan, seperti matahari terbit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume e luce aumentano dolcemente, come un'alba"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝日のように、音量と光がゆっくり強くなります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일출처럼 음량과 빛이 서서히 커집니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelantangan dan cahaya meningkat perlahan-lahan, seperti matahari terbit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume en licht nemen zachtjes toe, als een zonsopgang"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Volum og lys øker mykt, som en soloppgang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głośność i światło narastają łagodnie, jak wschód słońca"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume e a luz sobem suavemente, como um nascer do sol"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumul și lumina cresc lin, ca un răsărit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Громкость и свет нарастают плавно, как рассвет"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasitosť a svetlo silnejú pozvoľna ako východ slnka"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volym och ljus ökar mjukt, som en soluppgång"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงและแสงค่อยๆ เพิ่มขึ้นเหมือนพระอาทิตย์ขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve ışık gün doğumu gibi yavaşça yükselir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гучність і світло наростають плавно, як світанок"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm lượng và ánh sáng tăng dần như bình minh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量和亮光渐强，如日出般唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音量與光線漸強，如日出般喚醒"
          }
        }
      }
    },
