    "tracker_cancel_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will discard all sleep data from this session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto descartará todos los datos de sueño de esta sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso descartará todos os dados de sono desta sessão."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف جميع بيانات نوم هذه الجلسة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les dades de son d'aquesta sessió se suprimiran."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna data o spánku z této relace budou smazána."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle søvndata fra denne session slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Schlafdaten dieser Sitzung werden verworfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα δεδομένα ύπνου αυτής της συνεδρίας θα διαγραφούν."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän istunnon unitiedot poistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données de sommeil de cette session seront supprimées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל נתוני השינה של המפגש יימחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सत्र का सारा नींद डेटा हट जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi podaci o snu iz ove sesije bit će izbrisani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A munkamenet összes alvási adata törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua data tidur sesi ini akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dati del sonno di questa sessione verranno eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションの睡眠データはすべて破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션의 모든 수면 데이터가 삭제됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua data tidur sesi ini akan dipadamkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle slaapgegevens van deze sessie worden verwijderd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle søvndata fra denne økten slettes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie dane snu z tej sesji zostaną usunięte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dados de sono desta sessão serão eliminados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate datele de somn din această sesiune vor fi șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все данные сна этой сессии будут удалены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky údaje o spánku z tejto relácie budú vymazané."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "All sömndata från den här sessionen raderas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลการนอนของเซสชันนี้จะถูกลบทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumdaki tüm uyku verileri silinecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі дані сну цієї сесії буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ dữ liệu giấc ngủ của phiên này sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次会话的所有睡眠数据都将被丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次記錄的所有睡眠資料都會被捨棄。"
          }
        }
      }
    },
