    "tip_breathing_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the 4-7-8 technique: inhale for 4s, hold for 7s, exhale for 8s to calm your mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba la técnica 4-7-8: inhala 4s, mantén 7s, exhala 8s para calmar tu mente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente a técnica 4-7-8: inspire 4s, segure 7s, expire 8s para acalmar sua mente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب تقنية 4-7-8: شهيق 4 ثوانٍ، حبس 7 ثوانٍ، زفير 8 ثوانٍ لتهدئة العقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova la tècnica 4-7-8: inspira 4 s, aguanta 7 s i expira 8 s per calmar la ment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušejte techniku 4-7-8: nádech 4 s, zadržení 7 s, výdech 8 s pro zklidnění mysli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv 4-7-8-teknikken: Træk vejret ind i 4 sek., hold i 7 sek., pust ud i 8 sek. for at falde til ro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere die 4-7-8-Technik: 4 s einatmen, 7 s halten, 8 s ausatmen, um zur Ruhe zu kommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε την τεχνική 4-7-8: εισπνοή 4 δ., κράτημα 7 δ., εκπνοή 8 δ. για να ηρεμήσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile 4-7-8-tekniikkaa: hengitä sisään 4 s, pidätä 7 s ja hengitä ulos 8 s rauhoittuaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez la technique 4-7-8 : inspirez 4 s, retenez 7 s, expirez 8 s pour apaiser votre esprit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו את שיטת 4-7-8: שאיפה 4 שניות, החזקה 7 שניות, נשיפה 8 שניות להרגעת המחשבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "4-7-8 तकनीक आज़माएँ: 4 सेकंड साँस लें, 7 सेकंड रोकें, 8 सेकंड छोड़ें - मन शांत होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isprobaj tehniku 4-7-8: udahni 4 s, zadrži 7 s, izdahni 8 s kako bi se smirio."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáld a 4-7-8 technikát: 4 mp belégzés, 7 mp benntartás, 8 mp kilégzés a megnyugváshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba teknik 4-7-8: tarik napas 4 dtk, tahan 7 dtk, hembuskan 8 dtk untuk menenangkan pikiran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova la tecnica 4-7-8: inspira per 4 s, trattieni per 7 s, espira per 8 s per calmare la mente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4-7-8呼吸法を試しましょう。4秒吸って、7秒止めて、8秒かけて吐くと心が落ち着きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4-7-8 호흡법을 시도해 보세요. 4초 들이쉬고, 7초 참고, 8초 내쉬면 마음이 차분해집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba teknik 4-7-8: tarik nafas 4 saat, tahan 7 saat, hembus 8 saat untuk menenangkan fikiran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer de 4-7-8-techniek: adem 4 s in, houd 7 s vast en adem 8 s uit om tot rust te komen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv 4-7-8-teknikken: pust inn i 4 sek., hold i 7 sek., pust ut i 8 sek. for å roe sinnet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj technikę 4-7-8: wdech 4 s, zatrzymanie 7 s, wydech 8 s — to uspokaja umysł."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente a técnica 4-7-8: inspire 4 s, sustenha 7 s e expire 8 s para acalmar a mente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă tehnica 4-7-8: inspiră 4 s, ține 7 s, expiră 8 s pentru a-ți liniști mintea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте технику 4-7-8: вдох 4 с, задержка 7 с, выдох 8 с — это успокаивает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyskúšajte techniku 4-7-8: nádych 4 s, zadržanie 7 s, výdych 8 s na upokojenie mysle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova 4-7-8-tekniken: andas in i 4 s, håll i 7 s och andas ut i 8 s för att lugna sinnet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองเทคนิค 4-7-8: หายใจเข้า 4 วินาที กลั้น 7 วินาที หายใจออก 8 วินาที เพื่อให้จิตใจสงบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4-7-8 tekniğini deneyin: 4 sn nefes alın, 7 sn tutun, 8 sn verin; zihninizi sakinleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте техніку 4-7-8: вдих 4 с, затримка 7 с, видих 8 с — це заспокоює."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử kỹ thuật 4-7-8: hít vào 4 giây, giữ 7 giây, thở ra 8 giây để tâm trí thư thái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试 4-7-8 呼吸法：吸气 4 秒，屏息 7 秒，呼气 8 秒，让大脑平静下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試試 4-7-8 呼吸法：吸氣 4 秒、閉氣 7 秒、吐氣 8 秒，讓思緒平靜下來。"
          }
        }
      }
    },
