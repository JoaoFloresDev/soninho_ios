    },
    "tracker_battery_info_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep tracking and smart alarm run in background and may use additional battery. For best results, keep your device charged overnight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El monitoreo del sueño y la alarma inteligente funcionan en segundo plano y pueden usar batería adicional. Para mejores resultados, mantén tu dispositivo cargando durante la noche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O monitoramento de sono e alarme inteligente funcionam em segundo plano e podem usar bateria adicional. Para melhores resultados, mantenha o dispositivo carregando durante a noite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل تتبّع النوم والمنبّه الذكي في الخلفية وقد يستهلكان بطارية إضافية. يُفضّل شحن الجهاز طوال الليل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguiment del son i l'alarma intel·ligent funcionen en segon pla i poden gastar més bateria. L'ideal és deixar el dispositiu carregant durant la nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování spánku a chytrý budík běží na pozadí a mohou spotřebovávat více baterie. Nejlépe nechte zařízení přes noc nabíjet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søvnregistrering og den smarte alarm kører i baggrunden og kan bruge ekstra batteri. Oplad gerne enheden i løbet af natten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaftracking und smarter Alarm laufen im Hintergrund und können zusätzlichen Akku verbrauchen. Lade dein Gerät am besten über Nacht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η παρακολούθηση ύπνου και το έξυπνο ξυπνητήρι τρέχουν στο παρασκήνιο και μπορεί να καταναλώνουν επιπλέον μπαταρία. Ιδανικά, άφησε τη συσκευή στη φόρτιση τη νύχτα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unen seuranta ja älyherätys toimivat taustalla ja voivat kuluttaa akkua. Pidä laite mieluiten latauksessa yön yli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi du sommeil et l'alarme intelligente fonctionnent en arrière-plan et peuvent consommer plus de batterie. Idéalement, laissez l'iPhone en charge pendant la nuit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב שינה והשעון החכם פועלים ברקע ועשויים לצרוך סוללה נוספת. מומלץ להטעין את המכשיר במהלך הלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद ट्रैकिंग और स्मार्ट अलार्म बैकग्राउंड में चलते हैं और अतिरिक्त बैटरी ले सकते हैं। रात भर डिवाइस चार्ज पर रखना बेहतर है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Praćenje sna i pametni alarm rade u pozadini i mogu trošiti dodatnu bateriju. Najbolje je puniti uređaj preko noći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alváskövetés és az okos ébresztő a háttérben fut, és több akkumulátort használhat. Éjszakára érdemes töltőn hagyni a készüléket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelacakan tidur dan alarm pintar berjalan di latar belakang dan bisa memakai baterai ekstra. Sebaiknya isi daya perangkat semalaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il monitoraggio del sonno e la sveglia intelligente funzionano in background e possono consumare più batteria. Per risultati migliori, tieni il dispositivo in carica durante la notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の記録とスマートアラームはバックグラウンドで動作し、バッテリーを消費することがあります。夜間は充電したままにするのがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 기록과 스마트 알람은 백그라운드에서 실행되며 배터리를 더 사용할 수 있습니다. 밤에는 기기를 충전해 두는 것이 좋아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penjejakan tidur dan penggera pintar berjalan di latar belakang dan mungkin menggunakan bateri tambahan. Sebaiknya cas peranti sepanjang malam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaaptracking en de slimme wekker draaien op de achtergrond en kunnen extra batterij gebruiken. Laad je toestel het liefst 's nachts op."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Søvnregistrering og den smarte alarmen kjører i bakgrunnen og kan bruke ekstra batteri. Lad gjerne enheten i løpet av natten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie snu i inteligentny alarm działają w tle i mogą zużywać więcej baterii. Najlepiej ładuj urządzenie przez noc."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo do sono e o alarme inteligente funcionam em segundo plano e podem gastar mais bateria. Idealmente, deixe o telemóvel a carregar durante a noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorizarea somnului și alarma inteligentă rulează în fundal și pot consuma mai multă baterie. Ideal, lasă telefonul la încărcat peste noapte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание сна и умный будильник работают в фоне и могут расходовать больше заряда. Лучше оставлять устройство на зарядке на ночь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledovanie spánku a inteligentný budík bežia na pozadí a môžu spotrebúvať viac batérie. Najlepšie je nechať zariadenie cez noc nabíjať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sömnloggning och det smarta alarmet körs i bakgrunden och kan dra extra batteri. Ladda gärna enheten under natten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตามการนอนและปลุกอัจฉริยะทำงานเบื้องหลังและอาจใช้แบตเตอรี่เพิ่ม แนะนำให้ชาร์จเครื่องตลอดคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku takibi ve akıllı alarm arka planda çalışır ve ek pil kullanabilir. En iyi sonuç için cihazınızı gece şarjda tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстеження сну і розумний будильник працюють у фоні та можуть витрачати більше заряду. Найкраще залишати пристрій на зарядці на ніч."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi giấc ngủ và báo thức thông minh chạy nền nên có thể tốn thêm pin. Nên cắm sạc máy suốt đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠监测和智能闹钟会在后台运行，可能消耗更多电量。为获得最佳效果，请整夜为设备充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠追蹤與智慧鬧鐘會在背景執行，可能消耗較多電力。為獲得最佳效果，請整晚為裝置充電。"
          }
        }
      }
    },
