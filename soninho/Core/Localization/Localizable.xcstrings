    "tracker_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your sleep to understand your patterns and improve your rest quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorea tu sueño para entender tus patrones y mejorar la calidad de tu descanso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitore seu sono para entender seus padrões e melhorar a qualidade do seu descanso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبّع نومك لفهم أنماطك وتحسين جودة راحتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix el teu son per entendre els teus patrons i millorar el descans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte svůj spánek, pochopte své návyky a zlepšete odpočinek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg din søvn for at forstå dine mønstre og forbedre din hvile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deinen Schlaf, um deine Muster zu verstehen und deine Erholung zu verbessern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολούθησε τον ύπνο σου για να κατανοήσεις τα μοτίβα σου και να βελτιώσεις την ξεκούραση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa untasi ymmärtääksesi tottumuksiasi ja parantaaksesi lepoasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre sommeil pour comprendre vos habitudes et améliorer votre récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחרי השינה כדי להבין דפוסים ולשפר את איכות המנוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैटर्न समझने और आराम की गुणवत्ता बढ़ाने के लिए अपनी नींद ट्रैक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati svoj san kako bi razumio svoje navike i poboljšao odmor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesd az alvásodat, hogy megértsd a szokásaidat és javíts a pihenéseden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak tidurmu untuk memahami pola dan meningkatkan kualitas istirahat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora il tuo sonno per capire le tue abitudini e migliorare il riposo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠を記録してパターンを理解し、休息の質を高めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면을 기록해 패턴을 이해하고 휴식의 질을 높이세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejak tidur anda untuk memahami corak dan meningkatkan kualiti rehat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je slaap om je patronen te begrijpen en je rust te verbeteren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg søvnen din for å forstå mønstrene dine og forbedre hvilen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź swój sen, aby zrozumieć swoje wzorce i poprawić jakość odpoczynku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o seu sono para compreender os seus padrões e melhorar o descanso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorizează-ți somnul ca să-ți înțelegi tiparele și să-ți îmbunătățești odihna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте сон, чтобы понимать свои привычки и улучшать отдых."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte svoj spánok, pochopte svoje návyky a zlepšite odpočinok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ din sömn för att förstå dina mönster och förbättra din vila."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามการนอนเพื่อเข้าใจรูปแบบและยกระดับคุณภาพการพักผ่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uykunuzu takip ederek düzeninizi anlayın ve dinlenme kalitenizi artırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуйте сон, щоб розуміти свої звички та покращувати відпочинок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi giấc ngủ để hiểu thói quen và nâng cao chất lượng nghỉ ngơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你的睡眠，了解自己的睡眠模式，提升休息质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤你的睡眠，了解自己的睡眠模式，提升休息品質。"
          }
        }
      }
    },
