        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngủ sâu còn ít. Tránh caffeine và tập luyện trước giờ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
