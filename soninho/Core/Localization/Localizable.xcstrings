    "settings_autostart_sleep_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At bedtime, starts the night automatically when the app is open or running in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la hora de dormir, inicia la noche automáticamente cuando la app está abierta o activa en segundo plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No horário de dormir, inicia a noite sozinho quando o app está aberto ou ativo em segundo plano."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند موعد النوم، تبدأ الليلة تلقائياً إذا كان التطبيق مفتوحاً أو يعمل في الخلفية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A l'hora d'anar a dormir, la nit comença automàticament si l'app és oberta o en segon pla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V čase usínání noc začne automaticky, pokud je aplikace otevřená nebo běží na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved sengetid starter natten automatisk, hvis appen er åben eller kører i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Nacht zur Schlafenszeit automatisch, wenn die App offen ist oder im Hintergrund läuft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την ώρα ύπνου, η νύχτα ξεκινά αυτόματα αν η εφαρμογή είναι ανοιχτή ή στο παρασκήνιο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukkumaanmenoaikaan yö alkaa automaattisesti, jos appi on auki tai taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'heure du coucher, démarre la nuit automatiquement si l'app est ouverte ou en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשעת השינה, הלילה מתחיל אוטומטית אם האפליקציה פתוחה או פועלת ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने के समय पर, ऐप खुला या बैकग्राउंड में चलता होने पर रात अपने आप शुरू हो जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U vrijeme spavanja noć počinje automatski ako je aplikacija otvorena ili radi u pozadini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lefekvéskor az éjszaka automatikusan elindul, ha az app nyitva van vagy a háttérben fut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat waktu tidur, malam dimulai otomatis jika aplikasi terbuka atau berjalan di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'ora di andare a letto, avvia la notte automaticamente se l'app è aperta o in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時刻になると、アプリが開いているかバックグラウンドにある場合に自動で記録を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 시간이 되면 앱이 열려 있거나 백그라운드에서 실행 중일 때 자동으로 기록을 시작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada waktu tidur, malam bermula secara automatik jika aplikasi dibuka atau berjalan di latar belakang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de nacht automatisch rond bedtijd als de app open is of op de achtergrond draait."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved leggetid starter natten automatisk hvis appen er åpen eller kjører i bakgrunnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O porze snu noc rozpocznie się automatycznie, gdy aplikacja jest otwarta lub działa w tle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "À hora de deitar, inicia a noite automaticamente se a app estiver aberta ou em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La ora de culcare, noaptea începe automat dacă aplicația este deschisă sau rulează în fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В назначенное время ночь начнётся автоматически, если приложение открыто или работает в фоне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V čase spánku sa noc začne automaticky, ak je aplikácia otvorená alebo beží na pozadí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid läggdags startar natten automatiskt om appen är öppen eller körs i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถึงเวลานอน คืนจะเริ่มอัตโนมัติหากแอปเปิดอยู่หรือทำงานอยู่เบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma saatinde, uygulama açıkken veya arka planda çalışırken geceyi otomatik olarak başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У час сну ніч розпочнеться автоматично, якщо застосунок відкритий або працює у фоні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến giờ ngủ, đêm sẽ tự bắt đầu nếu ứng dụng đang mở hoặc chạy nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到就寝时间后，只要应用处于打开或后台运行状态，就会自动开始记录当晚睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到了就寢時間，只要 App 開啟或在背景執行，就會自動開始記錄當晚睡眠。"
          }
        }
      }
    },
