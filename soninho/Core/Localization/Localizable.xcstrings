          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitează amânările ca să te ridici cu adevărat la timp"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничьте отсрочки, чтобы вставать вовремя"
          }
        },
        "sk": {
          "stringUnit": {
