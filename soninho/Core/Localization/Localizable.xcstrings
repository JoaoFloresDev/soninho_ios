    "tracker_tip_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise uses your phone's sensors to detect movement and sound while you sleep. Keep it on the bed or nightstand for the best results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise usa los sensores de tu teléfono para detectar movimiento y sonido mientras duermes. Déjalo en la cama o mesita de noche para mejores resultados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunrise usa os sensores do celular para detectar movimento e som enquanto você dorme. Deixe-o na cama ou no criado-mudo para melhores resultados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Sunrise مستشعرات الآيفون لرصد الحركة والصوت أثناء نومك. ضعه على السرير أو الطاولة الجانبية لأفضل النتائج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise fa servir els sensors de l'iPhone per detectar moviment i so mentre dorms. Deixa'l al llit o a la tauleta de nit per obtenir els millors resultats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise využívá senzory iPhonu k rozpoznání pohybu a zvuku během spánku. Nejlepší výsledky získáte, když jej položíte na postel nebo noční stolek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise bruger din iPhones sensorer til at registrere bevægelse og lyd, mens du sover. Læg den på sengen eller natbordet for de bedste resultater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise nutzt die Sensoren deines iPhones, um Bewegung und Geräusche im Schlaf zu erkennen. Lege es für beste Ergebnisse aufs Bett oder den Nachttisch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sunrise χρησιμοποιεί τους αισθητήρες του iPhone για να ανιχνεύει κίνηση και ήχο όσο κοιμάσαι. Άφησέ το στο κρεβάτι ή στο κομοδίνο για καλύτερα αποτελέσματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise käyttää iPhonen antureita liikkeen ja äänen tunnistamiseen nukkuessasi. Aseta se sängylle tai yöpöydälle parhaan tuloksen saamiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise utilise les capteurs de votre iPhone pour détecter le mouvement et le bruit pendant votre sommeil. Posez-le sur le lit ou la table de nuit pour de meilleurs résultats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise משתמש בחיישני האייפון לזיהוי תנועה וקול בזמן השינה. הניחו אותו על המיטה או השידה לתוצאות מיטביות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise सोते समय हलचल और आवाज़ पहचानने के लिए iPhone के सेंसर इस्तेमाल करता है। बेहतरीन नतीजों के लिए इसे बिस्तर या साइड टेबल पर रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise koristi senzore iPhonea za praćenje pokreta i zvuka dok spavaš. Stavi ga na krevet ili noćni ormarić za najbolje rezultate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sunrise az iPhone érzékelőivel figyeli a mozgást és a hangot alvás közben. A legjobb eredményért tedd az ágyra vagy az éjjeliszekrényre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise memakai sensor iPhone untuk mendeteksi gerakan dan suara saat kamu tidur. Letakkan di kasur atau meja samping untuk hasil terbaik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise usa i sensori dell'iPhone per rilevare movimento e rumore mentre dormi. Tienilo sul letto o sul comodino per risultati migliori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SunriseはiPhoneのセンサーで睡眠中の動きと音を検知します。ベッドの上かナイトテーブルに置くと最も正確です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise는 iPhone의 센서로 수면 중 움직임과 소리를 감지합니다. 침대 위나 협탁에 두면 가장 정확해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise menggunakan penderia iPhone untuk mengesan pergerakan dan bunyi semasa anda tidur. Letakkan di atas katil atau meja sisi untuk hasil terbaik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise gebruikt de sensoren van je iPhone om beweging en geluid tijdens je slaap te herkennen. Leg hem op bed of op het nachtkastje voor het beste resultaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise bruker sensorene i iPhonen til å registrere bevegelse og lyd mens du sover. Legg den på senga eller nattbordet for best resultat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise używa czujników iPhone'a, aby wykrywać ruch i dźwięk podczas snu. Połóż go na łóżku lub szafce nocnej, aby uzyskać najlepsze wyniki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sunrise usa os sensores do iPhone para detetar movimento e som enquanto dorme. Coloque-o na cama ou na mesa de cabeceira para melhores resultados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise folosește senzorii iPhone-ului pentru a detecta mișcarea și sunetul în timp ce dormi. Pune-l pe pat sau pe noptieră pentru cele mai bune rezultate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise использует датчики iPhone, чтобы улавливать движение и звук во время сна. Для лучших результатов положите его на кровать или тумбочку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise využíva senzory iPhonu na rozpoznanie pohybu a zvuku počas spánku. Najlepšie výsledky získate, keď ho položíte na posteľ alebo nočný stolík."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise använder din iPhones sensorer för att känna av rörelse och ljud medan du sover. Lägg den på sängen eller nattduksbordet för bästa resultat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise ใช้เซ็นเซอร์ของ iPhone ตรวจจับการเคลื่อนไหวและเสียงขณะคุณหลับ วางไว้บนเตียงหรือโต๊ะข้างเตียงเพื่อผลลัพธ์ที่ดีที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise, uyurken hareketi ve sesi algılamak için iPhone'unuzun sensörlerini kullanır. En iyi sonuç için yatağın üzerinde veya komodinde tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise використовує датчики iPhone, щоб фіксувати рух і звук під час сну. Для найкращих результатів покладіть його на ліжко або тумбочку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise dùng cảm biến của iPhone để nhận diện chuyển động và âm thanh khi bạn ngủ. Đặt máy trên giường hoặc bàn cạnh giường để có kết quả tốt nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise 会使用手机传感器检测你睡觉时的体动和声音。把手机放在床上或床头柜上效果最佳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise 會使用手機的感測器，偵測你睡覺時的體動與聲音。把手機放在床上或床頭櫃效果最好。"
          }
        }
      }
    },
