    "alarm_smart_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake up during light sleep for a better morning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despierta durante el sueño ligero para una mejor mañana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorde durante o sono leve para uma manhã melhor"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظ أثناء النوم الخفيف لصباح أفضل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desperta't durant el son lleuger per a un matí millor"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probuďte se v lehkém spánku a mějte lepší ráno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågn op under let søvn og få en bedre morgen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach im leichten Schlaf auf, für einen besseren Morgen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξύπνα στον ελαφρύ ύπνο για ένα καλύτερο πρωινό"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herää kevyessä unessa, aamusta tulee parempi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveillez-vous en sommeil léger pour un meilleur matin"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התעוררו בשנת השינה הקלה לבוקר טוב יותר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतर सुबह के लिए हल्की नींद में जागें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Probudi se u laganom snu za bolje jutro"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébredj könnyű alvás közben egy jobb reggelért"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun saat tidur ringan untuk pagi yang lebih baik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svegliati nel sonno leggero per un mattino migliore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "浅い眠りのときに起きて、気持ちのいい朝に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얕은 수면일 때 깨워서 더 상쾌한 아침을"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun semasa tidur ringan untuk pagi yang lebih baik"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Word wakker in je lichte slaap voor een betere ochtend"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Våkn opp i lett søvn for en bedre morgen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budź się w lekkim śnie, by mieć lepszy poranek"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorde durante o sono leve para uma manhã melhor"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trezește-te în somnul ușor pentru o dimineață mai bună"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просыпайтесь в фазе лёгкого сна — утро будет добрее"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobuďte sa v ľahkom spánku a majte lepšie ráno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakna under lätt sömn för en bättre morgon"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตื่นในช่วงหลับตื้นเพื่อเช้าที่สดใสกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif uykuda uyanın, sabahınız daha iyi geçsin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокидайтеся у фазі легкого сну — ранок буде кращим"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thức dậy trong giấc ngủ nông để buổi sáng dễ chịu hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浅睡阶段唤醒你，早晨更轻松"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在淺眠時喚醒你，早晨更輕鬆"
          }
        }
      }
    },
