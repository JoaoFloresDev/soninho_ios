    "wake_mission_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make turning the alarm off require real effort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige esfuerzo real para apagar la alarma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige esforço de verdade para desligar o alarme"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل إيقاف المنبّه يتطلب جهداً حقيقياً"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes que apagar l'alarma requereixi un esforç real"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ať vypnutí budíku vyžaduje skutečné úsilí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør det til en reel indsats at slukke alarmen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach das Ausschalten des Alarms zu echter Arbeit"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε την απενεργοποίηση του ξυπνητηριού πραγματική προσπάθεια"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee herätyksen sammuttamisesta oikeaa työtä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigez un vrai effort pour éteindre l'alarme"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפכו את כיבוי ההתראה למאמץ אמיתי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म बंद करने में असली मेहनत लगवाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka isključivanje alarma zahtijeva pravi trud"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legyen igazi erőfeszítés az ébresztő kikapcsolása"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat mematikan alarm butuh usaha sungguhan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi lo spegnimento della sveglia un vero impegno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを止めるのに本当の努力を必要にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람을 끄려면 진짜 노력이 필요하게 만드세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadikan mematikan penggera memerlukan usaha sebenar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van het uitzetten van de wekker echt werk"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør det til en skikkelig innsats å slå av alarmen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niech wyłączenie alarmu wymaga prawdziwego wysiłku"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Torne desligar o alarme um esforço a sério"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă din oprirea alarmei un efort adevărat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выключить будильник, придётся постараться"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nech vypnutie budíka vyžaduje skutočné úsilie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör det till en riktig ansträngning att stänga av alarmet"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้การปิดปลุกต้องใช้ความพยายามจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmı kapatmak gerçek çaba gerektirsin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вимкнути будильник, доведеться постаратися"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khiến việc tắt báo thức đòi hỏi nỗ lực thật sự"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让关闭闹钟需要花点真功夫"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓關鬧鐘需要花點真功夫"
          }
        }
      }
    },
