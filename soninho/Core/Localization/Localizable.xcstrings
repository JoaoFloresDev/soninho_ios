    "bedtime_reminder_body %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bedtime is in %lld minutes. Start your wind-down routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu hora de dormir es en %lld minutos. Comienza tu rutina de relajación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua hora de dormir é em %lld minutos. Comece sua rotina de relaxamento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موعد نومك بعد %lld دقيقة. ابدأ روتين الاسترخاء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hora d'anar a dormir és d'aquí a %lld minuts. Comença a relaxar-te."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do usínání zbývá %lld minut. Začněte se zklidňovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sengetid er om %lld minutter. Begynd at slappe af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schlafenszeit ist in %lld Minuten. Zeit, zur Ruhe zu kommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ώρα ύπνου σου είναι σε %lld λεπτά. Ξεκίνα να χαλαρώνεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nukkumaanmenoaikaasi on %lld minuuttia. Aloita rauhoittuminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre coucher est dans %lld minutes. Commencez votre routine de détente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעת השינה שלך בעוד %lld דקות. התחילו להירגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने का समय %lld मिनट में। आराम की दिनचर्या शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijeme za spavanje je za %lld minuta. Počni se opuštati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld perc múlva van a lefekvés ideje. Kezdj el lazítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tidurmu %lld menit lagi. Mulailah bersantai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Andrai a dormire tra %lld minuti. Inizia la tua routine di relax."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝時刻まであと%lld分です。リラックスの準備を始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 시간까지 %lld분 남았습니다. 잘 준비를 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tidur anda dalam %lld minit lagi. Mulakan rutin bertenang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bedtijd is over %lld minuten. Begin met je avondroutine."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggetiden din er om %lld minutter. Begynn å roe ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pora snu za %lld minut. Zacznij się wyciszać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua hora de deitar é daqui a %lld minutos. Comece a relaxar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora de culcare este peste %lld minute. Începe să te relaxezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До отхода ко сну %lld мин. Начните готовиться ко сну."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do spánku zostáva %lld minút. Začnite sa upokojovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din läggdags är om %lld minuter. Börja varva ner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีก %lld นาทีจะถึงเวลานอน เริ่มผ่อนคลายได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatma saatinize %lld dakika kaldı. Sakinleşme rutininize başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До сну лишилося %lld хвилин. Починайте розслаблятися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn %lld phút đến giờ ngủ. Hãy bắt đầu thư giãn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 分钟就到就寝时间了。开始放松，准备睡觉吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 分鐘就到就寢時間了。開始放鬆，準備睡覺吧。"
          }
        }
      }
    },
    "bedtime_reminder_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to wind down and get ready for bed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de relajarte y prepararte para dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de desacelerar e se preparar pra dormir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان وقت الاسترخاء والاستعداد للنوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És hora de relaxar-se i preparar-se per dormir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je čas se uvolnit a připravit ke spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til at slappe af og gøre dig klar til at sove."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit, runterzufahren und dich bettfertig zu machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ώρα να χαλαρώσεις και να ετοιμαστείς για ύπνο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "On aika rauhoittua ja valmistautua nukkumaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est temps de vous détendre et de vous préparer à dormir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגיע הזמן להירגע ולהתכונן לשינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आराम करने और सोने की तैयारी का समय है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijeme je za opuštanje i pripremu za spavanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideje ellazulni és készülődni a lefekvéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatnya bersantai dan bersiap untuk tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È ora di rilassarti e prepararti per andare a letto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そろそろリラックスして、寝る準備をしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴장을 풀고 잘 준비를 할 시간이에요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa untuk bertenang dan bersiap untuk tidur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd om te ontspannen en je klaar te maken voor bed."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "På tide å roe ned og gjøre seg klar for natten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas się zrelaksować i przygotować do snu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está na hora de relaxar e preparar-se para dormir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E timpul să te relaxezi și să te pregătești de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пора расслабиться и готовиться ко сну."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je čas uvoľniť sa a pripraviť sa na spánok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dags att varva ner och göra dig redo för sängen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้เวลาผ่อนคลายและเตรียมตัวเข้านอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahatlama ve yatağa hazırlanma zamanı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час розслабитися і готуватися до сну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến lúc thư giãn và chuẩn bị đi ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该放松下来，准备睡觉了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該放鬆一下，準備睡覺了。"
          }
        }
      }
    },
