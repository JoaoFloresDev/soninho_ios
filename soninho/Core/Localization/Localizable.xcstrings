    "alarm_smart_wake_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your alarm will ring soon. Waking up now may feel easier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu alarma sonará pronto. Despertar ahora puede ser más fácil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu alarme vai tocar em breve. Acordar agora pode ser mais fácil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرن المنبّه قريباً. قد يكون الاستيقاظ الآن أسهل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alarma sonarà aviat. Potser ara és més fàcil despertar-se."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík brzy zazvoní. Probudit se teď může být snazší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din alarm ringer snart. Det kan føles lettere at vågne nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Alarm klingelt bald. Jetzt aufzuwachen fällt dir vielleicht leichter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ξυπνητήρι θα χτυπήσει σύντομα. Ίσως είναι πιο εύκολο να ξυπνήσεις τώρα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herätys soi pian. Herääminen voi tuntua nyt helpommalta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre alarme va bientôt sonner. Vous réveiller maintenant sera peut-être plus facile."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראה תצלצל בקרוב. ייתכן שקל יותר לקום עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म जल्द बजेगा। अभी उठना आसान हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm će uskoro zazvoniti. Sada bi se mogao lakše probuditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ébresztő hamarosan megszólal. Most könnyebb lehet felébredni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm akan segera berbunyi. Bangun sekarang mungkin terasa lebih mudah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sveglia suonerà a breve. Svegliarti adesso potrebbe essere più facile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まもなくアラームが鳴ります。今起きると楽に感じるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧 알람이 울립니다. 지금 일어나면 더 수월할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggera akan berbunyi tidak lama lagi. Bangun sekarang mungkin lebih mudah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wekker gaat zo af. Nu wakker worden voelt misschien makkelijker."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmen ringer snart. Det kan være lettere å våkne nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm wkrótce zadzwoni. Teraz może być łatwiej się obudzić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O alarme vai tocar em breve. Acordar agora pode ser mais fácil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarma va suna în curând. Poate fi mai ușor să te trezești acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник скоро зазвонит. Проснуться сейчас может быть легче."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Budík čoskoro zazvoní. Zobudiť sa teraz môže byť ľahšie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt alarm ringer snart. Det kan kännas lättare att vakna nu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกไม่นานนาฬิกาจะปลุก ตื่นตอนนี้อาจง่ายกว่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmınız yakında çalacak. Şimdi uyanmak daha kolay olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник скоро задзвонить. Прокинутися зараз може бути легше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo thức sắp reo. Dậy ngay bây giờ có thể dễ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟即将响起。现在醒来可能会更轻松。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鬧鐘即將響起。現在醒來可能會比較輕鬆。"
          }
        }
      }
    },
