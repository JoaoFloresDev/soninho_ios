    "alarm_snooze_section_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit snoozes to actually get up on time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita las siestas para levantarte a tiempo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite as sonecas para levantar na hora certa"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد الغفوات لتستيقظ فعلاً في الوقت المحدد"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita els posposaments per llevar-te de debò a l'hora"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezte odklady, abyste opravdu vstali včas"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begræns udsættelser, så du faktisk kommer op til tiden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenze das Schlummern, um wirklich pünktlich aufzustehen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιόρισε τις αναβολές για να σηκώνεσαι πραγματικά στην ώρα σου"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajoita torkkuja, jotta nouset oikeasti ajoissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitez les rappels pour vous lever vraiment à l'heure"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגבילו נודניקים כדי לקום באמת בזמן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय पर सचमुच उठने के लिए स्नूज़ सीमित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ograniči odgode kako bi stvarno ustao na vrijeme"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Korlátozd a szundikat, hogy tényleg időben kelj fel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batasi penundaan agar benar-benar bangun tepat waktu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita i posticipi per alzarti davvero in orario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スヌーズを制限して、時間どおりに起きましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 알림을 제한해서 제시간에 일어나세요"
