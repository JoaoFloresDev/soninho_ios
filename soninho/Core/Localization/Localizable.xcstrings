    "stats_tracker_empty_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track a night with Sunrise to see your sleep analysis here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una noche con Sunrise para ver tu análisis de sueño aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreie uma noite com o Sunrise pra ver suas análises de sono aqui."
