    "tip_wind_down_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start relaxing 30-60 minutes before bed with calming activities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza a relajarte 30-60 minutos antes de dormir con actividades tranquilas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a relaxar 30-60 minutos antes de dormir com atividades calmas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ الاسترخاء قبل النوم بـ30-60 دقيقة بأنشطة مهدّئة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comença a relaxar-te 30-60 minuts abans de dormir amb activitats tranquil·les."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte se uklidňovat 30–60 minut před spaním klidnými činnostmi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynd at slappe af 30-60 minutter før sengetid med rolige aktiviteter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne 30–60 Minuten vor dem Schlafengehen mit beruhigenden Aktivitäten zu entspannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνα να χαλαρώνεις 30-60 λεπτά πριν τον ύπνο με ήρεμες δραστηριότητες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita rauhoittuminen 30–60 minuuttia ennen nukkumaanmenoa rauhallisilla puuhilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à vous détendre 30 à 60 minutes avant le coucher avec des activités calmes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו להירגע 30-60 דקות לפני השינה עם פעילויות מרגיעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से 30-60 मिनट पहले शांत गतिविधियों से आराम शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počni se opuštati 30-60 minuta prije spavanja mirnim aktivnostima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdj el lazítani 30-60 perccel lefekvés előtt nyugodt tevékenységekkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulailah bersantai 30-60 menit sebelum tidur dengan aktivitas yang menenangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a rilassarti 30-60 minuti prima di andare a letto con attività tranquille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝の30〜60分前から、落ち着いた活動でリラックスを始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 30~60분 전부터 차분한 활동으로 긴장을 풀기 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan bertenang 30-60 minit sebelum tidur dengan aktiviti yang menenangkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin 30-60 minuten voor bedtijd te ontspannen met rustige activiteiten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynn å roe ned 30–60 minutter før leggetid med rolige aktiviteter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij się wyciszać 30–60 minut przed snem przy spokojnych zajęciach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a relaxar 30 a 60 minutos antes de deitar com atividades calmas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe să te relaxezi cu 30-60 de minute înainte de culcare cu activități liniștite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинайте расслабляться за 30–60 минут до сна за спокойными занятиями."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite sa upokojovať 30 – 60 minút pred spaním pokojnými činnosťami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja varva ner 30–60 minuter före läggdags med lugna aktiviteter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มผ่อนคลาย 30-60 นาทีก่อนนอนด้วยกิจกรรมสงบๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan 30-60 dakika önce sakin aktivitelerle gevşemeye başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починайте розслаблятися за 30–60 хвилин до сну за спокійними заняттями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu thư giãn 30-60 phút trước giờ ngủ với các hoạt động nhẹ nhàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 30-60 分钟开始做些让自己放松的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前 30-60 分鐘開始做些讓自己放鬆的事。"
          }
        }
      }
    },
