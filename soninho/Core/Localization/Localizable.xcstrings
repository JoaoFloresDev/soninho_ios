    "tip_exercise_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular exercise improves sleep quality, but avoid intense workouts close to bedtime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ejercicio regular mejora la calidad del sueño, pero evita entrenamientos intensos cerca de la hora de dormir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercícios regulares melhoram a qualidade do sono, mas evite treinos intensos perto da hora de dormir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرياضة المنتظمة تحسّن جودة النوم، لكن تجنّب التمارين الشاقة قرب موعد النوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exercici regular millora el son, però evita entrenaments intensos prop de l'hora de dormir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidelný pohyb zlepšuje spánek, ale vyhněte se náročným tréninkům těsně před spaním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmæssig motion forbedrer søvnen, men undgå hård træning tæt på sengetid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmäßige Bewegung verbessert die Schlafqualität, aber vermeide intensives Training kurz vor dem Schlafengehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τακτική άσκηση βελτιώνει τον ύπνο, αλλά απόφυγε έντονη προπόνηση κοντά στην ώρα ύπνου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säännöllinen liikunta parantaa unta, mutta vältä rankkoja treenejä juuri ennen nukkumaanmenoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exercice régulier améliore le sommeil, mais évitez les séances intenses proches du coucher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעילות גופנית סדירה משפרת את איכות השינה, אך הימנעו מאימון מאומץ סמוך לשינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियमित व्यायाम नींद सुधारता है, पर सोने से ठीक पहले कठिन व्यायाम न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redovito vježbanje poboljšava san, ali izbjegavaj intenzivne treninge blizu spavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszeres mozgás javítja az alvást, de kerüld az intenzív edzést közvetlenül lefekvés előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Olahraga rutin meningkatkan kualitas tidur, tapi hindari latihan berat menjelang tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esercizio regolare migliora il sonno, ma evita allenamenti intensi vicino all'ora di dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的な運動は睡眠の質を高めますが、就寝直前の激しい運動は避けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙적인 운동은 수면의 질을 높이지만, 취침 직전의 격한 운동은 피하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaman berkala meningkatkan kualiti tidur, tetapi elakkan senaman berat hampir waktu tidur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmatig bewegen verbetert je slaap, maar vermijd intensieve trainingen vlak voor bedtijd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelmessig trening bedrer søvnen, men unngå harde økter rett før leggetid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regularny ruch poprawia sen, ale unikaj intensywnych treningów tuż przed snem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O exercício regular melhora o sono, mas evite treinos intensos perto da hora de deitar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercițiile regulate îmbunătățesc somnul, dar evită antrenamentele intense aproape de culcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулярные тренировки улучшают сон, но избегайте интенсивных нагрузок перед сном."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidelný pohyb zlepšuje spánok, ale vyhnite sa náročným tréningom tesne pred spaním."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelbunden träning förbättrar sömnen, men undvik hårda pass nära läggdags."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกกำลังกายสม่ำเสมอช่วยให้นอนหลับดีขึ้น แต่เลี่ยงออกกำลังหนักใกล้เวลานอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli egzersiz uykuyu iyileştirir; ancak yatmadan hemen önce yoğun antrenmandan kaçının."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулярні тренування покращують сон, але уникайте інтенсивних навантажень перед сном."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tập luyện đều đặn giúp ngủ ngon hơn, nhưng tránh tập nặng sát giờ ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规律运动能改善睡眠质量，但睡前应避免高强度锻炼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規律運動能改善睡眠品質，但睡前避免高強度訓練。"
          }
        }
      }
    },
