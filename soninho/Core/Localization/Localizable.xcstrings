    "tracker_step2_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We analyze your sleep cycles, identifying deep, light, and REM phases throughout the night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizamos tus ciclos de sueño, identificando fases profunda, ligera y REM durante la noche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisamos seus ciclos de sono, identificando fases profundo, leve e REM durante a noite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحلل دورات نومك ونحدد مراحل النوم الخفيف والعميق وحركة العين طوال الليل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Analitzem els teus cicles de son identificant les fases lleugera, profunda i REM tota la nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celou noc analyzujeme vaše spánkové cykly a rozpoznáváme lehkou, hlubokou a REM fázi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi analyserer dine søvncyklusser og identificerer let, dyb og REM-søvn hele natten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir analysieren deine Schlafzyklen und erkennen leichte, tiefe und REM-Phasen die ganze Nacht hindurch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναλύουμε τους κύκλους ύπνου σου, αναγνωρίζοντας ελαφρύ, βαθύ και REM στάδιο όλη τη νύχτα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysoimme unisyklisi ja tunnistamme kevyen, syvän ja REM-unen koko yön ajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous analysons vos cycles et identifions les phases légères, profondes et paradoxales toute la nuit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנחנו מנתחים את מחזורי השינה ומזהים שלבי שינה קלה, עמוקה ו-REM לאורך הלילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम रात भर आपके नींद चक्रों का विश्लेषण कर हल्की, गहरी और REM नींद पहचानते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiziramo tvoje cikluse sna i prepoznajemo laganu, duboku i REM fazu cijelu noć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egész éjjel elemezzük az alvási ciklusaidat, felismerve a könnyű, mély és REM-fázisokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menganalisis siklus tidurmu, mengenali tahap ringan, nyenyak, dan REM sepanjang malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizziamo i tuoi cicli identificando le fasi leggere, profonde e REM per tutta la notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一晩を通して睡眠サイクルを分析し、浅い・深い・レム睡眠を判定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤새 수면 주기를 분석해 얕은 수면, 깊은 수면, 렘수면 단계를 식별합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menganalisis kitaran tidur anda, mengenal pasti peringkat ringan, lena dan REM sepanjang malam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We analyseren je slaapcycli en herkennen de hele nacht lichte, diepe en REM-fasen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi analyserer søvnsyklusene dine og gjenkjenner lett, dyp og REM-søvn hele natten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizujemy Twoje cykle snu, rozpoznając fazy lekką, głęboką i REM przez całą noc."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisamos os seus ciclos de sono, identificando as fases leve, profunda e REM ao longo da noite."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizăm ciclurile tale de somn, identificând fazele ușoară, profundă și REM pe toată durata nopții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы анализируем циклы сна и распознаём лёгкую, глубокую и БДГ-фазы всю ночь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celú noc analyzujeme vaše spánkové cykly a rozpoznávame ľahkú, hlbokú a REM fázu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi analyserar dina sömncykler och identifierar lätt, djup och REM-sömn hela natten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราวิเคราะห์รอบการนอนของคุณ แยกระยะหลับตื้น หลับลึก และ REM ตลอดคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece boyunca uyku döngülerinizi analiz ediyor; hafif, derin ve REM evrelerini belirliyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми аналізуємо цикли сну і розпізнаємо легку, глибоку та REM-фази всю ніч."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi phân tích chu kỳ giấc ngủ, nhận diện giai đoạn nông, sâu và REM suốt đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会分析你的睡眠周期，识别整晚的深睡、浅睡和 REM 阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會分析你的睡眠週期，辨識整晚的深眠、淺眠與 REM 階段。"
          }
        }
      }
    },
