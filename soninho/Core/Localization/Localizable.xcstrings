    "tip_meditation_desc": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even 5-10 minutes of meditation before bed can reduce stress and improve sleep quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso 5-10 minutos de meditación antes de dormir pueden reducir el estrés y mejorar el sueño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 5-10 minutos de meditação antes de dormir podem reduzir o estresse e melhorar o sono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى 5-10 دقائق من التأمل قبل النوم تقلل التوتر وتحسّن النوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fins i tot 5-10 minuts de meditació abans de dormir poden reduir l'estrès i millorar el son."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I 5–10 minut meditace před spaním sníží stres a zlepší kvalitu spánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare 5-10 minutters meditation før sengetid kan mindske stress og forbedre søvnen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon 5–10 Minuten Meditation vor dem Schlafengehen können Stress abbauen und die Schlafqualität verbessern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και 5-10 λεπτά διαλογισμού πριν τον ύπνο μειώνουν το άγχος και βελτιώνουν τον ύπνο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo 5–10 minuutin meditaatio ennen nukkumaanmenoa voi vähentää stressiä ja parantaa unta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même 5 à 10 minutes de méditation avant le coucher peuvent réduire le stress et améliorer le sommeil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפילו 5-10 דקות מדיטציה לפני השינה מפחיתות מתח ומשפרות את השינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोने से पहले 5-10 मिनट का ध्यान भी तनाव घटाकर नींद सुधारता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već 5-10 minuta meditacije prije spavanja smanjuje stres i poboljšava san."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már 5-10 perc lefekvés előtti meditáció is csökkenti a stresszt és javítja az alvást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meditasi 5-10 menit sebelum tidur pun bisa mengurangi stres dan memperbaiki tidur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche 5-10 minuti di meditazione prima di dormire possono ridurre lo stress e migliorare il sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝前の5〜10分の瞑想でも、ストレスが減り睡眠の質が向上します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취침 전 5~10분의 명상만으로도 스트레스가 줄고 수면의 질이 좋아질 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meditasi 5-10 minit sebelum tidur pun boleh mengurangkan tekanan dan memperbaiki tidur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs 5-10 minuten meditatie voor het slapen kan stress verminderen en je slaap verbeteren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare 5–10 minutter meditasjon før leggetid kan redusere stress og bedre søvnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet 5–10 minut medytacji przed snem zmniejsza stres i poprawia jakość snu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo 5 a 10 minutos de meditação antes de deitar reduzem o stress e melhoram o sono."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiar și 5-10 minute de meditație înainte de culcare reduc stresul și îmbunătățesc somnul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже 5–10 минут медитации перед сном снижают стресс и улучшают сон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aj 5 – 10 minút meditácie pred spaním zníži stres a zlepší kvalitu spánku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan 5–10 minuters meditation före sängen kan minska stress och förbättra sömnen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำสมาธิเพียง 5-10 นาทีก่อนนอนก็ช่วยลดเครียดและนอนหลับดีขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatmadan önce 5-10 dakikalık meditasyon bile stresi azaltıp uyku kalitesini artırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть 5–10 хвилин медитації перед сном зменшують стрес і покращують сон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ 5-10 phút thiền trước giờ ngủ cũng giảm căng thẳng và cải thiện giấc ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前哪怕只冥想 5-10 分钟，也能减轻压力、改善睡眠质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前即使只冥想 5-10 分鐘，也能減輕壓力、改善睡眠品質。"
          }
        }
      }
    },
