          "stringUnit": {
            "state": "translated",
            "value": "Ringer igen, hvis du lægger dig ned igen efter at have slukket"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt erneut, wenn du dich nach dem Ausschalten wieder hinlegst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξαναχτυπά αν ξαπλώσεις ξανά αφού το απενεργοποιήσεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soi uudelleen, jos käyt takaisin makuulle sammutuksen jälkeen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resonne si vous vous recouchez après avoir arrêté l'alarme"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצלצל שוב אם חזרתם לשכב אחרי הכיבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करने के बाद फिर लेटने पर दोबारा बजता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno zvoni ako legneš nakon što ga isključiš"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újra csörög, ha kikapcsolás után visszafekszel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi lagi jika kamu berbaring kembali setelah mematikannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona di nuovo se torni a sdraiarti dopo averla spenta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを止めた後に二度寝すると、再び鳴ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람을 끈 뒤 다시 누우면 알람이 다시 울립니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi semula jika anda baring semula selepas mematikannya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat opnieuw af als je weer gaat liggen na het uitzetten"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer igjen hvis du legger deg ned etter å ha slått av"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadzwoni ponownie, jeśli położysz się z powrotem po wyłączeniu"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a tocar se se deitar novamente depois de desligar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sună din nou dacă te întinzi la loc după ce ai oprit-o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвонит снова, если вы снова ляжете после отключения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zazvoní znova, ak si po vypnutí opäť ľahnete"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringer igen om du lägger dig ner efter att ha stängt av"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลุกซ้ำหากคุณกลับไปนอนหลังปิดเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapattıktan sonra tekrar yatarsanız yeniden çalar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задзвонить знову, якщо ви ляжете назад після вимкнення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reo lại nếu bạn nằm xuống tiếp sau khi tắt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
