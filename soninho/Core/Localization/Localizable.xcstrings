    "snooze_greeting_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See you in a few minutes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te aviso en unos minutos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Te chamo de novo em alguns minutos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نراك بعد دقائق"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ens veiem d'aquí a uns minuts"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidíme se za pár minut"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ses om et par minutter"
          }
