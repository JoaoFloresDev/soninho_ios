    "paywall_info": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment will be charged to your Apple ID account. Subscription automatically renews unless canceled 24 hours before the end of the current period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se cargará a tu cuenta de Apple ID. La suscripción se renueva automáticamente a menos que se cancele 24 horas antes del final del período actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento será cobrado na sua conta Apple ID. A assinatura renova automaticamente a menos que seja cancelada 24 horas antes do fim do período atual."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم الخصم من حساب Apple الخاص بك. يتجدد الاشتراك تلقائياً ما لم يُلغَ قبل 24 ساعة على الأقل من نهاية الفترة الحالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pagament es carregarà al teu compte d'Apple. La subscripció es renova automàticament si no es cancel·la almenys 24 hores abans del final del període actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba bude stržena z vašeho účtu Apple. Předplatné se automaticky obnovuje, pokud jej nezrušíte alespoň 24 hodin před koncem aktuálního období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen trækkes på din Apple-konto. Abonnementet fornyes automatisk, medmindre det opsiges mindst 24 timer før den aktuelle periodes udløb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird über dein Apple-ID-Konto abgerechnet. Das Abo verlängert sich automatisch, wenn es nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πληρωμή θα χρεωθεί στον λογαριασμό σου Apple. Η συνδρομή ανανεώνεται αυτόματα εκτός αν ακυρωθεί τουλάχιστον 24 ώρες πριν από τη λήξη της τρέχουσας περιόδου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksu veloitetaan Apple-tililtäsi. Tilaus uusiutuu automaattisesti, ellei sitä peruta vähintään 24 tuntia ennen kuluvan jakson päättymistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement sera débité de votre compte Apple. L'abonnement se renouvelle automatiquement sauf s'il est annulé au moins 24 heures avant la fin de la période en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיוב יבוצע בחשבון Apple שלכם. המינוי מתחדש אוטומטית אלא אם בוטל לפחות 24 שעות לפני סוף התקופה הנוכחית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान आपके Apple खाते से लिया जाएगा। मौजूदा अवधि खत्म होने से कम से कम 24 घंटे पहले रद्द न करने पर सदस्यता अपने आप नवीनीकृत होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaćanje će se naplatiti s tvog Apple računa. Pretplata se automatski obnavlja osim ako se ne otkaže najmanje 24 sata prije kraja tekućeg razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fizetés az Apple-fiókodra lesz terhelve. Az előfizetés automatikusan megújul, hacsak nem mondod le legalább 24 órával az aktuális időszak vége előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran akan dibebankan ke akun Apple-mu. Langganan diperpanjang otomatis kecuali dibatalkan setidaknya 24 jam sebelum akhir periode berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento verrà addebitato sul tuo account Apple. L'abbonamento si rinnova automaticamente se non viene annullato almeno 24 ore prima della fine del periodo in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いはApple IDアカウントに請求されます。現在の期間が終了する24時間前までにキャンセルしない限り、サブスクリプションは自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 금액은 Apple 계정으로 청구됩니다. 현재 기간 종료 24시간 전까지 취소하지 않으면 구독이 자동으로 갱신됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayaran akan dicaj ke akaun Apple anda. Langganan diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat tempoh semasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betaling wordt in rekening gebracht via je Apple-account. Het abonnement wordt automatisch verlengd, tenzij je het minstens 24 uur voor het einde van de huidige periode opzegt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen belastes Apple-kontoen din. Abonnementet fornyes automatisk med mindre det sies opp minst 24 timer før gjeldende periode utløper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność zostanie pobrana z Twojego konta Apple. Subskrypcja odnawia się automatycznie, jeśli nie anulujesz jej co najmniej 24 godziny przed końcem bieżącego okresu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento será debitado na sua conta Apple. A subscrição renova-se automaticamente, salvo se for cancelada pelo menos 24 horas antes do fim do período atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata va fi debitată din contul tău Apple. Abonamentul se reînnoiește automat dacă nu este anulat cu cel puțin 24 de ore înainte de sfârșitul perioadei curente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата будет списана с вашей учётной записи Apple. Подписка продлевается автоматически, если не отменить её минимум за 24 часа до конца текущего периода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba bude stiahnutá z vášho účtu Apple. Predplatné sa automaticky obnovuje, ak ho nezrušíte aspoň 24 hodín pred koncom aktuálneho obdobia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalningen debiteras ditt Apple-konto. Prenumerationen förnyas automatiskt om den inte sägs upp minst 24 timmar före den aktuella periodens slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเรียกเก็บเงินผ่านบัญชี Apple ของคุณ การสมัครจะต่ออายุอัตโนมัติ เว้นแต่ยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme Apple hesabınızdan tahsil edilir. Mevcut dönemin bitiminden en az 24 saat önce iptal edilmezse abonelik otomatik olarak yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата стягується з вашого облікового запису Apple. Підписка поновлюється автоматично, якщо не скасувати її щонайменше за 24 години до кінця поточного періоду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh toán sẽ được tính vào tài khoản Apple của bạn. Gói đăng ký tự động gia hạn trừ khi hủy ít nhất 24 giờ trước khi kết thúc kỳ hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用将通过你的 Apple ID 账户收取。订阅将自动续期，除非在当前订阅期结束前至少 24 小时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "費用將透過你的 Apple ID 帳號收取。訂閱會自動續訂，除非在目前期間結束前至少 24 小時取消。"
          }
        }
      }
    },
