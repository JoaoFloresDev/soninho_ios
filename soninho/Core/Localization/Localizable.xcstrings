    "tracker_cycles_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each cycle lasts about 90 minutes and includes light, deep, and REM phases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ciclo dura aproximadamente 90 minutos e incluye fases ligera, profunda y REM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ciclo dura cerca de 90 minutos e inclui fases leve, profundo e REM."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر كل دورة حوالي 90 دقيقة وتشمل مراحل النوم الخفيف والعميق وحركة العين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cicle dura uns 90 minuts i inclou fases lleugera, profunda i REM."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý cyklus trvá asi 90 minut a zahrnuje lehkou, hlubokou a REM fázi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver cyklus varer cirka 90 minutter og indeholder let, dyb og REM-søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Zyklus dauert etwa 90 Minuten und umfasst leichte, tiefe und REM-Phasen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε κύκλος διαρκεί περίπου 90 λεπτά και περιλαμβάνει ελαφρύ, βαθύ και REM στάδιο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen sykli kestää noin 90 minuuttia ja sisältää kevyen, syvän ja REM-vaiheen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque cycle dure environ 90 minutes et comprend des phases légères, profondes et paradoxales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מחזור נמשך כ-90 דקות וכולל שלבי שינה קלה, עמוקה ו-REM."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चक्र लगभग 90 मिनट का होता है और इसमें हल्की, गहरी और REM नींद शामिल है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki ciklus traje oko 90 minuta i uključuje laganu, duboku i REM fazu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ciklus körülbelül 90 percig tart, és könnyű, mély és REM-fázisokból áll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap siklus berlangsung sekitar 90 menit dan mencakup tahap ringan, nyenyak, dan REM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ciclo dura circa 90 minuti e comprende fasi leggere, profonde e REM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サイクルは約90分で、浅い睡眠・深い睡眠・レム睡眠が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 주기는 약 90분이며 얕은 수면, 깊은 수면, 렘수면 단계로 이루어집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kitaran berlangsung kira-kira 90 minit dan merangkumi peringkat ringan, lena dan REM."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke cyclus duurt ongeveer 90 minuten en bevat lichte, diepe en REM-fasen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver syklus varer i cirka 90 minutter og inneholder lett, dyp og REM-søvn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy cykl trwa około 90 minut i obejmuje fazy lekką, głęboką i REM."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ciclo dura cerca de 90 minutos e inclui fases leve, profunda e REM."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare ciclu durează aproximativ 90 de minute și include fazele ușoară, profundă și REM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый цикл длится около 90 минут и включает лёгкую, глубокую и БДГ-фазы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý cyklus trvá približne 90 minút a zahŕňa ľahkú, hlbokú a REM fázu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje cykel varar cirka 90 minuter och innehåller lätt, djup och REM-sömn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละรอบยาวประมาณ 90 นาที ประกอบด้วยหลับตื้น หลับลึก และ REM"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her döngü yaklaşık 90 dakika sürer; hafif, derin ve REM evrelerini içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен цикл триває близько 90 хвилин і включає легку, глибоку та REM-фази."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi chu kỳ kéo dài khoảng 90 phút, gồm các giai đoạn ngủ nông, sâu và REM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个周期约 90 分钟，包含浅睡、深睡和 REM 阶段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個週期約 90 分鐘，包含淺眠、深眠與 REM 階段。"
          }
        }
      }
    },
