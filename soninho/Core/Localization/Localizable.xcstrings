          "stringUnit": {
            "state": "translated",
            "value": "Reading a physical book (not a screen) can help you relax and fall asleep faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer un libro físico (no una pantalla) puede ayudarte a relajarte y dormir más rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um livro físico (não uma tela) pode ajudá-lo a relaxar e dormir mais rápido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة كتاب ورقي (وليس شاشة) تساعدك على الاسترخاء والنوم أسرع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegir un llibre en paper (no una pantalla) ajuda a relaxar-se i adormir-se més ràpid."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtení papírové knihy (ne obrazovky) pomáhá uvolnit se a rychleji usnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At læse en fysisk bog (ikke en skærm) hjælper dig med at slappe af og falde hurtigere i søvn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gedrucktes Buch (kein Bildschirm) hilft dir, zu entspannen und schneller einzuschlafen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το διάβασμα ενός έντυπου βιβλίου (όχι οθόνης) βοηθά να χαλαρώσεις και να κοιμηθείς πιο γρήγορα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperikirjan lukeminen (ei näytön) auttaa rentoutumaan ja nukahtamaan nopeammin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un livre papier (pas un écran) aide à se détendre et à s'endormir plus vite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת ספר מודפס (לא מסך) עוזרת להירגע ולהירדם מהר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताब पढ़ना (स्क्रीन नहीं) आराम देता है और जल्दी नींद लाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitanje tiskane knjige (ne ekrana) pomaže opuštanju i bržem usnivanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy papírkönyv olvasása (nem képernyő) segít ellazulni és gyorsabban elaludni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca buku fisik (bukan layar) membantu rileks dan tidur lebih cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere un libro cartaceo (non uno schermo) aiuta a rilassarsi e ad addormentarsi prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙の本を読む（画面ではなく）と、リラックスして早く眠りにつけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 아닌 종이책을 읽으면 긴장이 풀리고 더 빨리 잠들 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca buku fizikal (bukan skrin) membantu anda relaks dan lelap lebih cepat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een papieren boek lezen (geen scherm) helpt je ontspannen en sneller in slaap vallen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lese en fysisk bok (ikke en skjerm) hjelper deg å slappe av og sovne raskere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytanie papierowej książki (nie ekranu) pomaga się zrelaksować i szybciej zasnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um livro em papel (não um ecrã) ajuda a relaxar e a adormecer mais depressa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cititul unei cărți tipărite (nu al unui ecran) te ajută să te relaxezi și să adormi mai repede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение бумажной книги (не экрана) помогает расслабиться и быстрее заснуть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čítanie papierovej knihy (nie obrazovky) pomáha uvoľniť sa a rýchlejšie zaspať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att läsa en fysisk bok (inte en skärm) hjälper dig slappna av och somna snabbare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านหนังสือเล่ม (ไม่ใช่หน้าจอ) ช่วยให้ผ่อนคลายและหลับเร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basılı bir kitap okumak (ekran değil) rahatlamanıza ve daha hızlı uyumanıza yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання паперової книжки (не екрана) допомагає розслабитися і швидше заснути."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc sách giấy (không phải màn hình) giúp thư giãn và dễ ngủ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读一本纸质书（而不是屏幕）能帮你放松，更快入睡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀一本實體書（不是螢幕）能幫你放鬆、更快入睡。"
          }
        }
      }
    },
